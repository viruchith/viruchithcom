---
import "../styles/global.css";
import sansWoff2 from "@fontsource-variable/schibsted-grotesk/files/schibsted-grotesk-latin-wght-normal.woff2?url";
import monoWoff2 from "@fontsource-variable/jetbrains-mono/files/jetbrains-mono-latin-wght-normal.woff2?url";
import SiteHeader, { type NavKey } from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import { siteConfig } from "../config/site";

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  ogType?: "website" | "article";
  structuredData?: Record<string, unknown> | Array<Record<string, unknown>>;
  preloadImage?: {
    src: string;
    srcset?: string;
    sizes?: string;
  };
  current?: NavKey;
  trail?: string;
}

const {
  title,
  description = siteConfig.description,
  ogImage,
  ogType = "website",
  structuredData,
  preloadImage,
  current,
  trail,
} = Astro.props;

const canonical = new URL(
  Astro.url.pathname,
  Astro.site ?? siteConfig.siteUrl,
);

const isIndex = Astro.url.pathname === "/" || Astro.url.pathname === "/index.html";
const resolvedTitle = isIndex ? siteConfig.title : (title ?? siteConfig.title);
const resolvedOgImage = new URL(
  ogImage ?? siteConfig.ogImage,
  Astro.site ?? siteConfig.siteUrl,
).toString();

const structuredDataItems = structuredData
  ? Array.isArray(structuredData)
    ? structuredData
    : [structuredData]
  : [];

const basePersonSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: siteConfig.name,
  url: siteConfig.siteUrl,
  email: siteConfig.email,
  jobTitle: siteConfig.headlineRole,
  description: siteConfig.pitch,
  image: `${siteConfig.siteUrl}${siteConfig.ogImage}`,
  sameAs: [
    siteConfig.socials.github,
    siteConfig.socials.linkedin,
    siteConfig.socials.x,
  ],
  knowsAbout: [
    "Java",
    "Spring Boot",
    "Microservices",
    "Kubernetes",
    "Google Cloud Platform",
    "PostgreSQL",
    "RabbitMQ",
    "RESTful APIs",
    "Legacy Java Modernization",
    "Distributed Systems",
    "Observability",
  ],
  alumniOf: {
    "@type": "CollegeOrUniversity",
    name: "Sona College of Technology",
  },
  worksFor: {
    "@type": "Organization",
    name: "Lumen Technologies",
  },
  address: {
    "@type": "PostalAddress",
    addressLocality: "Bengaluru",
    addressCountry: "IN",
  },
};

const baseWebSiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: "viruchith.com",
  url: siteConfig.siteUrl,
  description: siteConfig.description,
  author: {
    "@type": "Person",
    name: siteConfig.name,
  },
};
---

<!doctype html>
<html lang="en" class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      (function () {
        var root = document.documentElement;
        root.classList.remove("no-js");
        root.classList.add("js");
        var preference = "system";
        try {
          var stored = localStorage.getItem("theme");
          if (stored === "light" || stored === "dark") preference = stored;
        } catch {}
        var isDark =
          preference === "dark" ||
          (preference === "system" && window.matchMedia("(prefers-color-scheme: dark)").matches);
        root.dataset.theme = isDark ? "dark" : "light";
        root.dataset.themePreference = preference;
        var color = document.createElement("meta");
        color.name = "theme-color";
        color.setAttribute("data-theme-color", "");
        color.content = isDark ? "#0a0a0b" : "#fafaf8";
        document.head.appendChild(color);
      })();
    </script>
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="keywords" content={siteConfig.keywords.join(", ")} />
    <meta name="author" content={siteConfig.name} />
    <meta name="robots" content="index,follow,max-image-preview:large" />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#fafaf8" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#0a0a0b" />

    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="application/rss+xml" title={`${siteConfig.name} — Technical Articles`} href="/rss.xml" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" href="/favicon-16x16.png" sizes="16x16" type="image/png" />
    <link rel="icon" href="/favicon-32x32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />

    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={resolvedTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="viruchith.com" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content={resolvedOgImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={siteConfig.ogImageAlt} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={resolvedTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={resolvedOgImage} />
    <meta name="twitter:image:alt" content={siteConfig.ogImageAlt} />
    <title>{resolvedTitle}</title>
    {
      [
        basePersonSchema,
        baseWebSiteSchema,
        ...structuredDataItems,
      ].map((item) => (
        <script type="application/ld+json" is:inline set:html={JSON.stringify(item)} />
      ))
    }
    <link rel="preload" href={sansWoff2} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={monoWoff2} as="font" type="font/woff2" crossorigin />
    {
      preloadImage && (
        <link
          rel="preload"
          as="image"
          href={preloadImage.src}
          imagesrcset={preloadImage.srcset}
          imagesizes={preloadImage.sizes}
          fetchpriority="high"
        />
      )
    }
    <slot name="head" />
    <style>
      #cat-widget-container {
        position: fixed;
        inset: 0;
        z-index: 2147483647;
        pointer-events: none;
      }

      #cat-widget-container canvas {
        display: block;
      }
    </style>
  </head>
  <body>
    <!-- Google Tag Manager (noscript) -->
    <noscript
      ><iframe
        src="https://www.googletagmanager.com/ns.html?id=GTM-WFS47GTS"
        height="0"
        width="0"
        style="display:none;visibility:hidden"></iframe></noscript
    >
    <!-- End Google Tag Manager (noscript) -->
    <a href="#main" class="skip-link">Skip to content</a>
    <div id="cat-widget-container" aria-hidden="true"></div>
    <SiteHeader current={current} trail={trail} />
    <main id="main" tabindex="-1" class="outline-none">
      <slot />
    </main>
    <SiteFooter />
    <script>
      const browserWindow = window as Record<string, any>;

      const loadGtm = () => {
        if (browserWindow["__gtmLoaded"]) {
          return;
        }

        browserWindow["__gtmLoaded"] = true;
        browserWindow["dataLayer"] = browserWindow["dataLayer"] || [];
        browserWindow["dataLayer"].push({
          "gtm.start": new Date().getTime(),
          event: "gtm.js",
        });

        const firstScript = document.getElementsByTagName("script")[0];
        const gtmScript = document.createElement("script");
        gtmScript.async = true;
        gtmScript.src = "https://www.googletagmanager.com/gtm.js?id=GTM-WFS47GTS";

        if (firstScript?.parentNode) {
          firstScript.parentNode.insertBefore(gtmScript, firstScript);
        } else {
          document.head.appendChild(gtmScript);
        }
      };

      const scheduleGtm = () => {
        const boot = () => {
          if ("requestIdleCallback" in browserWindow) {
            browserWindow.requestIdleCallback(() => loadGtm(), { timeout: 7000 });
          } else {
            globalThis.setTimeout(() => loadGtm(), 12000);
          }
        };

        const onFirstInteraction = () => {
          window.removeEventListener("pointerdown", onFirstInteraction);
          window.removeEventListener("keydown", onFirstInteraction);
          window.removeEventListener("touchstart", onFirstInteraction);
          window.removeEventListener("scroll", onFirstInteraction);
          boot();
        };

        window.addEventListener("pointerdown", onFirstInteraction, { once: true, passive: true });
        window.addEventListener("keydown", onFirstInteraction, { once: true });
        window.addEventListener("touchstart", onFirstInteraction, { once: true, passive: true });
        window.addEventListener("scroll", onFirstInteraction, { once: true, passive: true });

        if (document.readyState === "complete") {
          globalThis.setTimeout(() => {
            onFirstInteraction();
          }, 12000);
          return;
        }

        window.addEventListener("load", () => {
          globalThis.setTimeout(() => {
            onFirstInteraction();
          }, 12000);
        }, { once: true });
      };

      scheduleGtm();

      // The cat is opt-in: three.js and the model load only after the visitor enables it.
      const CAT_KEY = "cat";
      let cat: { destroy(): void } | null = null;
      let catLoading = false;

      const readCatPreference = () => {
        try {
          return localStorage.getItem(CAT_KEY) === "on";
        } catch {
          return false;
        }
      };

      const syncCatControls = (enabled: boolean) => {
        document.querySelectorAll<HTMLButtonElement>("[data-cat-toggle]").forEach((button) => {
          button.setAttribute("aria-pressed", String(enabled));
          const label = button.querySelector("[data-cat-label]");
          if (label) label.textContent = enabled ? "Put the cat away" : "Let the cat out";
        });
        document.querySelectorAll("[data-cat-status]").forEach((status) => {
          status.textContent = enabled ? "The cat is out." : "The cat is asleep.";
        });
      };

      const enableCat = async () => {
        if (cat || catLoading) return;
        catLoading = true;
        try {
          const { initCatWidget } = await import("../lib/cat-widget");
          if (catWanted) cat = initCatWidget();
        } catch (error) {
          console.warn("Cat widget failed to load", error);
        } finally {
          catLoading = false;
        }
      };

      const disableCat = () => {
        cat?.destroy();
        cat = null;
      };

      const setCat = (enabled: boolean) => {
        catWanted = enabled;
        try {
          localStorage.setItem(CAT_KEY, enabled ? "on" : "off");
        } catch {
          /* Without storage the choice lasts for this page only. */
        }
        syncCatControls(enabled);
        if (enabled) void enableCat();
        else disableCat();
      };

      document.addEventListener("click", (event) => {
        const toggle = (event.target as Element | null)?.closest?.("[data-cat-toggle]");
        if (!toggle) return;
        setCat(toggle.getAttribute("aria-pressed") !== "true");
      });

      let catWanted = readCatPreference();
      syncCatControls(catWanted);
      if (catWanted) {
        if ("requestIdleCallback" in browserWindow) {
          browserWindow.requestIdleCallback(() => void enableCat(), { timeout: 4000 });
        } else {
          globalThis.setTimeout(() => void enableCat(), 1500);
        }
      }
    </script>
  </body>
</html>
