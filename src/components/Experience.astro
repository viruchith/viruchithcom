---
import Section from './ui/Section.astro';
import Link from './ui/Link.astro';
import { experiences } from '../data/experience';
import { slugify } from '../lib/format';

function renderBulletText(text: string) {
  return text.replace(/\*\*(.*?)\*\*/g, '<strong class="font-semibold text-ink">$1</strong>');
}
---

<Section id="experience" title="Experience">
  <ol class="flex flex-col">
    {
      experiences.map((exp, index) => (
        <li
          id={`exp-${slugify(exp.role)}`}
          class:list={['grid gap-x-8 gap-y-1 py-6 lg:grid-cols-9', index === 0 ? 'pt-0' : 'border-t border-rule']}
        >
          <p class="hidden pt-0.5 font-mono text-meta text-faint lg:col-span-2 lg:block">
            <time datetime={exp.startIso}>{exp.startIso}</time>
            <span aria-hidden="true"> — </span>
            <span class="sr-only"> to </span>
            {exp.endIso ? <time datetime={exp.endIso}>{exp.endIso}</time> : <span>now</span>}
          </p>
          <div class="min-w-0 lg:col-span-7">
            <h3 class="text-title font-semibold">{exp.role}</h3>
            <p class="mt-1 text-small text-muted">
              {exp.company} · {exp.location}
              <span class="lg:hidden">
                {' · '}
                <time datetime={exp.startIso}>{exp.startDate}</time> – {exp.endDate}
              </span>
            </p>
            <ul class="bullets mt-4 flex max-w-[68ch] flex-col gap-3 text-body">
              {exp.bullets.map((bullet) => (
                <li>
                  <span set:html={renderBulletText(bullet.text)} />
                  {bullet.relatedArticle && (
                    <span class="mt-1.5 block text-small">
                      <Link
                        href={`/articles/${bullet.relatedArticle.slug}/`}
                        variant="xref"
                        trail={`Article: ${bullet.relatedArticle.title}`}
                      >{bullet.relatedArticle.title}</Link>
                    </span>
                  )}
                </li>
              ))}
            </ul>
          </div>
        </li>
      ))
    }
  </ol>
</Section>
