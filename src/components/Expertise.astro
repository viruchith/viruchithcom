---
import Section from './ui/Section.astro';
import { skillCategories } from '../data/skills';
---

<Section id="skills" title="Skills">
  <dl class="flex flex-col">
    {
      skillCategories.map((category, index) => (
        <div class:list={['grid gap-x-8 gap-y-2 py-5 lg:grid-cols-9', index === 0 ? 'pt-0' : 'border-t border-rule']}>
          <dt class="lg:col-span-3">
            <span class="text-title font-semibold text-ink">{category.title}</span>
            <span class="mt-1 block text-small text-muted">{category.description}</span>
          </dt>
          <dd class="lg:col-span-6">
            <ul class="flex flex-wrap gap-x-1 gap-y-1.5 text-body">
              {category.skills.map((skill, skillIndex) => (
                <li class:list={[category.isCore ? 'text-ink' : 'text-body']}>
                  {skill.name}{skillIndex < category.skills.length - 1 && <span class="text-faint" aria-hidden="true">,</span>}
                </li>
              ))}
            </ul>
          </dd>
        </div>
      ))
    }
  </dl>
</Section>
