---
import { LayoutGrid, Cpu, Wrench, Database, History } from '@lucide/astro';
import { skillCategories } from '../data/skills';

const iconMap = [Cpu, Wrench, Database, History];
---

<section id="skills" class="mb-40 px-6 md:px-12 lg:px-24" aria-labelledby="skills-heading">
  <div class="mb-16 flex items-end justify-between border-b border-surface-container-low pb-8 transition-colors">
    <div>
      <h2 id="skills-heading" class="font-headline mb-2 text-3xl font-bold text-on-background md:text-4xl">
        Skills
      </h2>
      <p class="font-body text-on-surface-variant">Core competencies, cloud infrastructure, and modernization toolchain.</p>
    </div>
    <LayoutGrid class="h-10 w-10 shrink-0 text-primary opacity-50 md:h-11 md:w-11" stroke-width={1.25} aria-hidden="true" />
  </div>

  <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-2">
    {
      skillCategories.map((category, idx) => {
        const IconComponent = iconMap[idx] || Cpu;
        return (
          <div
            class={`group relative overflow-hidden rounded-2xl border p-8 transition-all ${
              category.isCore
                ? 'border-primary-container/30 bg-surface-container-low shadow-[0_0_20px_rgba(0,240,255,0.06)]'
                : 'border-outline-variant/15 bg-surface-container-low hover:bg-surface-container/90'
            }`}
          >
            <div
              class="absolute right-0 top-0 h-32 w-32 rounded-bl-full bg-primary/5 transition-transform group-hover:scale-110"
              aria-hidden="true"
            />

            <div class="mb-6 flex items-center justify-between gap-4">
              <div class="flex items-center gap-4">
                <div class="flex h-12 w-12 items-center justify-center rounded-lg border border-outline-variant/20 bg-surface-container-lowest text-primary">
                  <IconComponent class="h-6 w-6" stroke-width={1.5} aria-hidden="true" />
                </div>
                <div>
                  <h3 class="font-headline text-xl font-bold text-on-background">{category.title}</h3>
                  {category.isCore && (
                    <span class="font-mono text-[0.65rem] uppercase tracking-wider text-primary font-semibold">
                      Primary Target Focus
                    </span>
                  )}
                </div>
              </div>
            </div>

            <p class="mb-6 text-sm text-on-surface-variant font-body">
              {category.description}
            </p>

            <div class="flex flex-wrap gap-2.5">
              {category.skills.map((skill) => (
                <span
                  class={`rounded-md border px-3.5 py-1.5 font-body text-sm transition-colors ${
                    skill.isPrimary
                      ? 'border-primary-container/30 bg-primary-container/10 font-medium text-primary'
                      : 'border-outline-variant/20 bg-surface-container-lowest text-on-surface'
                  }`}
                >
                  {skill.name}
                </span>
              ))}
            </div>
          </div>
        );
      })
    }
  </div>
</section>
