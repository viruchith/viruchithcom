---
import Section from './ui/Section.astro';
import { testimonials } from '../data/testimonials';
---

{
  testimonials.length > 0 && (
    <Section id="recommendations" title="Recommendations">
      <ul class="grid gap-x-8 border-t border-rule xl:grid-cols-2">
        {testimonials.map((t) => (
          <li class="border-b border-rule py-6">
            <figure>
              <blockquote class="max-w-[62ch] text-body text-ink">
                <p>“{t.quote}”</p>
              </blockquote>
              <figcaption class="mt-4 text-small text-muted">
                <span class="font-semibold text-ink">{t.author}</span>, {t.role} · {t.company}
              </figcaption>
            </figure>
          </li>
        ))}
      </ul>
    </Section>
  )
}
