---
import { UserCheck, Sparkles, Layers, ShieldCheck } from '@lucide/astro';
---

<section id="about" class="mb-32 px-6 md:px-12 lg:px-24" aria-labelledby="about-heading">
  <div class="mb-12 flex items-end justify-between border-b border-surface-container-low pb-6">
    <div>
      <h2 id="about-heading" class="font-headline mb-2 text-3xl font-bold text-on-background md:text-4xl">
        About
      </h2>
      <p class="font-body text-on-surface-variant">
        Engineering background, systems built, and current focus.
      </p>
    </div>
    <UserCheck class="h-9 w-9 shrink-0 text-primary opacity-50 md:h-10 md:w-10" stroke-width={1.3} aria-hidden="true" />
  </div>

  <div class="grid gap-10 lg:grid-cols-[minmax(0,1fr)_20rem]">
    <!-- Short, plain-prose section (97 words, strictly within 80-120 words) -->
    <div class="rounded-2xl border border-outline-variant/15 bg-surface-container-low/60 p-8 md:p-10">
      <p class="font-body text-lg leading-relaxed text-on-surface md:text-xl md:leading-9">
        I am a backend engineer based in Bengaluru with 3+ years of hands-on experience designing, scaling, and modernizing enterprise backend systems. At Lumen Technologies, I led the architecture and containerization of legacy Tomcat, WildFly, and Restlet applications into Spring Boot microservices running on GCP and Kubernetes, and engineered mission-critical telecom qualification APIs processing over 100,000 requests daily. My technical foundation centers on Java, Spring Boot, distributed messaging with RabbitMQ, PostgreSQL, Linux administration, and deep production observability. I am currently looking for full-time backend engineering and cloud-native platform roles, as well as select Spring Boot modernization consulting engagements.
      </p>

      <div class="mt-8 flex flex-wrap gap-4 text-sm text-on-surface-variant">
        <span class="inline-flex items-center gap-2">
          <span class="font-semibold text-primary">Core stack:</span> Java, Spring Boot, Kubernetes, GCP, RabbitMQ, PostgreSQL
        </span>
      </div>
    </div>

    <!-- Key snapshot pillars -->
    <div class="grid gap-4">
      <div class="rounded-2xl border border-outline-variant/15 bg-surface-container-low p-5">
        <div class="flex items-center gap-3">
          <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-surface-container-lowest text-primary">
            <Layers class="h-5 w-5" stroke-width={1.6} aria-hidden="true" />
          </div>
          <div>
            <p class="text-sm font-bold text-on-background">Production Scale</p>
            <p class="text-xs text-on-surface-variant">100,000+ daily telecom qualification API requests</p>
          </div>
        </div>
      </div>

      <div class="rounded-2xl border border-outline-variant/15 bg-surface-container-low p-5">
        <div class="flex items-center gap-3">
          <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-surface-container-lowest text-primary">
            <Sparkles class="h-5 w-5" stroke-width={1.6} aria-hidden="true" />
          </div>
          <div>
            <p class="text-sm font-bold text-on-background">Legacy Modernization</p>
            <p class="text-xs text-on-surface-variant">Decomposed Restlet &amp; WildFly into Spring Boot on K8s</p>
          </div>
        </div>
      </div>

      <div class="rounded-2xl border border-outline-variant/15 bg-surface-container-low p-5">
        <div class="flex items-center gap-3">
          <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-surface-container-lowest text-primary">
            <ShieldCheck class="h-5 w-5" stroke-width={1.6} aria-hidden="true" />
          </div>
          <div>
            <p class="text-sm font-bold text-on-background">Certified Cloud Credential</p>
            <p class="text-xs text-on-surface-variant">Google Cloud Associate Cloud Engineer (GCP ACE)</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
