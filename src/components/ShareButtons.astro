---
import { Link2, Share2, Mail } from '@lucide/astro';
import { siX, siFacebook, siWhatsapp } from 'simple-icons';
import BrandLinkedin from './icons/BrandLinkedin.astro';

interface Props {
  url: string;
  title: string;
  description?: string;
  id: string;
}

const { url, title, description, id } = Astro.props;
const panelId = `share-panel-${id}`;
const mailHref = `mailto:?subject=${encodeURIComponent(title)}&body=${encodeURIComponent(description ? `${description}\n\n${url}` : url)}`;
---

<div class="share relative flex flex-wrap items-center gap-2" data-share data-share-url={url} data-share-title={title}>
  <button type="button" class="btn btn-secondary btn-sm" data-share-copy>
    <Link2 class="h-4 w-4" stroke-width={1.75} aria-hidden="true" />
    <span data-share-copy-label>Copy link</span>
  </button>
  <button
    type="button"
    class="btn btn-secondary btn-sm"
    aria-expanded="false"
    aria-controls={panelId}
    data-share-toggle
  >
    <Share2 class="h-4 w-4" stroke-width={1.75} aria-hidden="true" />
    Share
  </button>
  <span class="sr-only" role="status" data-share-status></span>

  <ul
    id={panelId}
    class="absolute right-0 top-full z-20 mt-2 w-52 border border-rule-strong bg-raised py-1 md:left-auto"
    hidden
    data-share-panel
  >
    <li>
      <button type="button" class="share__item sharer" data-sharer="twitter" data-url={url} data-title={title}>
        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d={siX.path} /></svg>
        X
      </button>
    </li>
    <li>
      <button type="button" class="share__item sharer" data-sharer="linkedin" data-url={url}>
        <BrandLinkedin class="h-4 w-4" />
        LinkedIn
      </button>
    </li>
    <li>
      <button type="button" class="share__item sharer" data-sharer="facebook" data-url={url}>
        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d={siFacebook.path} /></svg>
        Facebook
      </button>
    </li>
    <li>
      <button type="button" class="share__item sharer" data-sharer="whatsapp" data-url={url} data-title={title}>
        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d={siWhatsapp.path} /></svg>
        WhatsApp
      </button>
    </li>
    <li>
      <a href={mailHref} class="share__item">
        <Mail class="h-4 w-4" stroke-width={1.75} aria-hidden="true" />
        Email
      </a>
    </li>
  </ul>
</div>

<style is:global>
  .share__item {
    @apply flex min-h-10 w-full items-center gap-3 px-3 text-left text-small text-ink;
    transition:
      background-color 120ms ease-out,
      color 120ms ease-out;
  }

  .share__item:hover,
  .share__item:focus-visible {
    background: var(--ink);
    color: var(--paper);
  }
</style>

<script is:inline src="/sharer.min.js"></script>
<script>
  document.querySelectorAll<HTMLElement>('[data-share]').forEach((root) => {
    if (root.dataset.bound) return;
    root.dataset.bound = '1';

    const url = root.dataset.shareUrl ?? location.href;
    const title = root.dataset.shareTitle ?? document.title;
    const copyButton = root.querySelector<HTMLButtonElement>('[data-share-copy]');
    const copyLabel = root.querySelector('[data-share-copy-label]');
    const toggle = root.querySelector<HTMLButtonElement>('[data-share-toggle]');
    const panel = root.querySelector<HTMLElement>('[data-share-panel]');
    const status = root.querySelector('[data-share-status]');

    copyButton?.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(url);
        if (copyLabel) copyLabel.textContent = 'Copied';
        if (status) status.textContent = 'Article link copied to clipboard';
      } catch {
        window.prompt('Copy the article link', url);
      }
      window.setTimeout(() => {
        if (copyLabel) copyLabel.textContent = 'Copy link';
      }, 2000);
    });

    const setOpen = (open: boolean) => {
      if (!panel || !toggle) return;
      panel.hidden = !open;
      toggle.setAttribute('aria-expanded', String(open));
    };

    toggle?.addEventListener('click', async () => {
      if (navigator.share && matchMedia('(pointer: coarse)').matches) {
        try {
          await navigator.share({ title, url });
          return;
        } catch (error) {
          if ((error as DOMException).name === 'AbortError') return;
        }
      }
      setOpen(panel?.hidden ?? false);
    });

    document.addEventListener('click', (event) => {
      if (!root.contains(event.target as Node)) setOpen(false);
    });

    root.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && panel && !panel.hidden) {
        setOpen(false);
        toggle?.focus();
      }
    });
  });
</script>
