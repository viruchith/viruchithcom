---
import { Search } from '@lucide/astro';
import ArticleItem from './ui/ArticleItem.astro';
---

<div class="js-only" data-search>
  <label for="article-search" class="sr-only">Search articles</label>
  <div class="search-field">
    <Search class="h-4 w-4 shrink-0 text-faint" stroke-width={1.75} aria-hidden="true" />
    <input
      id="article-search"
      type="search"
      placeholder="Search titles, topics, and full text"
      autocomplete="off"
      spellcheck="false"
      enterkeyhint="search"
      class="min-w-0 flex-1 bg-transparent text-body text-ink outline-none placeholder:text-faint"
      aria-describedby="article-search-status"
      data-search-input
    />
    <kbd class="hidden rounded border border-rule px-1.5 font-mono text-meta text-faint sm:inline" aria-hidden="true">/</kbd>
  </div>
  <div class="mt-3 flex min-h-8 flex-wrap items-center gap-x-3 gap-y-1">
    <p id="article-search-status" class="text-small text-muted" role="status" data-search-status></p>
    <button type="button" class="btn btn-ghost btn-sm" hidden data-search-clear>Clear search</button>
    <button type="button" class="btn btn-ghost btn-sm" hidden data-search-retry>Try again</button>
  </div>
</div>

<template id="article-item-template">
  <ArticleItem />
</template>

<style is:global>
  .search-field {
    @apply flex h-12 items-center gap-3 rounded border border-rule-strong bg-raised px-3;
    transition: border-color 120ms ease-out;
  }

  .search-field:hover {
    @apply border-faint;
  }

  .search-field:focus-within {
    @apply border-ink;
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  .search-field input:focus-visible {
    outline: none;
  }

  .search-field input::-webkit-search-cancel-button {
    display: none;
  }

  mark {
    background: var(--accent-wash);
    color: var(--ink);
  }
</style>

<script>
  import Fuse from 'fuse.js';

  interface SearchItem {
    slug: string;
    title: string;
    description: string;
    category: string;
    tags: string[];
    publishDate: string;
    formattedDate: string;
    readingTime: string;
    heroImage?: string;
    body: string;
  }

  const root = document.querySelector<HTMLElement>('[data-search]');
  const input = document.querySelector<HTMLInputElement>('[data-search-input]');
  const status = document.querySelector<HTMLElement>('[data-search-status]');
  const clearButton = document.querySelector<HTMLButtonElement>('[data-search-clear]');
  const retryButton = document.querySelector<HTMLButtonElement>('[data-search-retry]');
  const defaultView = document.querySelector<HTMLElement>('[data-search-default]');
  const resultsList = document.querySelector<HTMLElement>('[data-search-results]');
  const resultsRegion = document.querySelector<HTMLElement>('[data-search-region]') ?? resultsList;
  const template = document.getElementById('article-item-template') as HTMLTemplateElement | null;

  let fuse: Fuse<SearchItem> | null = null;
  let loading: Promise<void> | null = null;
  let failed = false;
  let timer: ReturnType<typeof setTimeout> | undefined;

  function setStatus(message: string) {
    if (status) status.textContent = message;
  }

  function loadIndex() {
    if (fuse) return Promise.resolve();
    if (loading) return loading;
    failed = false;
    if (retryButton) retryButton.hidden = true;
    loading = fetch('/articles/search.json')
      .then((response) => {
        if (!response.ok) throw new Error(`Search index returned ${response.status}`);
        return response.json() as Promise<SearchItem[]>;
      })
      .then((items) => {
        fuse = new Fuse(items, {
          keys: [
            { name: 'title', weight: 0.4 },
            { name: 'description', weight: 0.2 },
            { name: 'body', weight: 0.25 },
            { name: 'category', weight: 0.075 },
            { name: 'tags', weight: 0.075 },
          ],
          threshold: 0.3,
          ignoreLocation: true,
          useExtendedSearch: true,
        });
      })
      .catch((error) => {
        console.error('[search]', error);
        failed = true;
      })
      .finally(() => {
        loading = null;
      });
    return loading;
  }

  function escapeHtml(value: string) {
    return value.replace(/[&<>"']/g, (char) => `&#${char.charCodeAt(0)};`);
  }

  function highlight(value: string, query: string) {
    const safe = escapeHtml(value);
    const words = query
      .split(/\s+/)
      .filter((word) => word.length >= 2)
      .map((word) => escapeHtml(word).replace(/[.*+?^${}()|[\]\\]/g, '\\$&'));
    if (!words.length) return safe;
    return safe.replace(new RegExp(`(${words.join('|')})`, 'gi'), '<mark>$1</mark>');
  }

  function showDefault() {
    if (defaultView) defaultView.hidden = false;
    if (resultsRegion) resultsRegion.hidden = true;
    resultsList?.replaceChildren();
    if (clearButton) clearButton.hidden = true;
    setStatus('');
  }

  function render(query: string) {
    if (!resultsList || !template || !defaultView) return;

    if (failed) {
      setStatus('Search could not load. The list below still works.');
      if (retryButton) retryButton.hidden = false;
      return;
    }
    if (!fuse) return;

    const words = query
      .split(/\s+/)
      .map((word) => word.replace(/[|'!^$=]/g, ''))
      .filter(Boolean);
    let results = words.length ? fuse.search(words.map((word) => `'${word}`).join(' ')) : [];
    if (!results.length) results = fuse.search({ $or: [{ title: query }, { description: query }] });
    defaultView.hidden = true;
    if (resultsRegion) resultsRegion.hidden = false;
    if (clearButton) clearButton.hidden = false;
    resultsList.replaceChildren();

    if (!results.length) {
      setStatus(`No articles match “${query}”. Try a broader term, or clear the search to browse.`);
      return;
    }

    setStatus(`${results.length} ${results.length === 1 ? 'article matches' : 'articles match'} “${query}”.`);

    for (const { item } of results) {
      const fragment = template.content.cloneNode(true) as DocumentFragment;
      const href = `/articles/${item.slug}/`;
      const link = fragment.querySelector<HTMLAnchorElement>('[data-item-link]');
      if (link) {
        link.href = href;
        link.innerHTML = highlight(item.title, query);
      }
      const thumb = fragment.querySelector<HTMLAnchorElement>('[data-item-thumb]');
      if (thumb) thumb.href = href;
      const image = fragment.querySelector<HTMLImageElement>('[data-item-image]');
      if (image && item.heroImage) image.src = item.heroImage;
      const description = fragment.querySelector('[data-item-description]');
      if (description) description.innerHTML = highlight(item.description, query);
      const isoDay = item.publishDate.slice(0, 10);
      fragment.querySelectorAll<HTMLTimeElement>('[data-item-date]').forEach((node) => {
        node.dateTime = isoDay;
        node.textContent = isoDay;
      });
      fragment.querySelectorAll<HTMLTimeElement>('[data-item-date-short]').forEach((node) => {
        node.dateTime = isoDay;
        node.textContent = item.formattedDate;
      });
      const category = fragment.querySelector('[data-item-category]');
      if (category) category.textContent = item.category;
      const reading = fragment.querySelector('[data-item-reading]');
      if (reading) reading.textContent = item.readingTime;
      resultsList.appendChild(fragment);
    }
  }

  async function run() {
    const query = input?.value.trim() ?? '';
    if (query.length < 2) {
      showDefault();
      if (query.length === 1) setStatus('Type at least two characters.');
      return;
    }
    if (!fuse && !failed) setStatus('Loading the search index…');
    await loadIndex();
    if ((input?.value.trim() ?? '') === query) render(query);
  }

  if (root && input) {
    input.addEventListener('focus', () => void loadIndex(), { once: true });
    input.addEventListener('input', () => {
      clearTimeout(timer);
      timer = setTimeout(() => void run(), 120);
    });
    input.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && input.value) {
        event.preventDefault();
        input.value = '';
        showDefault();
      }
    });

    clearButton?.addEventListener('click', () => {
      input.value = '';
      showDefault();
      input.focus();
    });

    retryButton?.addEventListener('click', () => {
      failed = false;
      void run();
    });

    window.addEventListener('keydown', (event) => {
      const active = document.activeElement;
      const editing =
        active instanceof HTMLInputElement ||
        active instanceof HTMLTextAreaElement ||
        (active instanceof HTMLElement && active.isContentEditable);
      if (event.key === '/' && !editing && !event.metaKey && !event.ctrlKey && !event.altKey) {
        event.preventDefault();
        input.focus();
      }
    });
  }
</script>
