---
import Section from './ui/Section.astro';

const certifications = [
  { name: 'Google Cloud Certified — Associate Cloud Engineer', issuer: 'Google Cloud', earned: '2024-02' },
  { name: 'Google Cloud Certified — Generative AI Leader', issuer: 'Google Cloud', earned: '2026-10' },
  { name: 'Microsoft Azure Fundamentals (AZ-900)', issuer: 'Microsoft', earned: '2021-02' },
  { name: 'Enterprise Networking, Security & Automation', issuer: 'Cisco', earned: '2021-03' },
];
---

<Section id="education" title="Education">
  <div class="grid gap-x-8 gap-y-1 lg:grid-cols-9">
    <p class="hidden pt-0.5 font-mono text-meta text-faint lg:col-span-2 lg:block">
      <time datetime="2019">2019</time><span aria-hidden="true"> — </span><span class="sr-only"> to </span><time datetime="2023">2023</time>
    </p>
    <div class="lg:col-span-7">
      <h3 class="text-title font-semibold">Bachelor of Computer Science and Engineering</h3>
      <p class="mt-1 text-small text-muted">
        Sona College of Technology, Salem, Tamil Nadu · <span class="lg:hidden">2019 – 2023 · </span>GPA <span class="figure">8.85</span> / 10
      </p>
    </div>
  </div>

  <div id="certifications" class="mt-8 border-t border-rule pt-6">
    <h3 class="text-title font-semibold">Certifications</h3>
    <ul class="mt-4 grid gap-x-8 xl:grid-cols-2">
      {
        certifications.map((cert) => (
          <li class="grid grid-cols-[5.5rem_minmax(0,1fr)] gap-x-4 border-t border-rule py-3 text-small">
            <time datetime={cert.earned} class="pt-px font-mono text-meta text-faint">{cert.earned}</time>
            <span>
              <span class="text-ink">{cert.name}</span>
              <span class="block text-muted">{cert.issuer}</span>
            </span>
          </li>
        ))
      }
    </ul>
  </div>
</Section>
