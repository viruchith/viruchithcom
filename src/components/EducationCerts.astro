---
import { GraduationCap, Award, Cloud, ShieldCheck } from '@lucide/astro';
---

<section id="education" class="mb-40 px-6 md:px-12 lg:px-24" aria-labelledby="education-heading">
  <div class="mb-16 flex items-end justify-between border-b border-surface-container-low pb-8 transition-colors">
    <div>
      <h2 id="education-heading" class="font-headline mb-2 text-3xl font-bold text-on-background md:text-4xl">
        Education &amp; Credentials
      </h2>
      <p class="font-body text-on-surface-variant">
        Academic foundation and verified technical certifications.
      </p>
    </div>
    <GraduationCap class="h-10 w-10 shrink-0 text-primary opacity-50 md:h-11 md:w-11" stroke-width={1.25} aria-hidden="true" />
  </div>

  <div class="space-y-8">
    <!-- Condensed Education to One Row -->
    <div class="rounded-2xl border border-outline-variant/15 bg-surface-container-low p-6 md:p-8 transition-all hover:bg-surface-container/80">
      <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4">
        <div class="flex items-start md:items-center gap-4">
          <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl border border-outline-variant/20 bg-surface-container-lowest text-primary">
            <GraduationCap class="h-6 w-6" stroke-width={1.6} aria-hidden="true" />
          </div>
          <div>
            <h3 class="font-headline text-xl font-bold text-on-background">
              Bachelor of Computer Science and Engineering
            </h3>
            <p class="font-body text-sm text-on-surface-variant">
              Sona College of Technology — Salem, Tamil Nadu, India · 2019 – 2023 · <span class="text-primary font-medium">GPA: 8.85 / 10</span>
            </p>
          </div>
        </div>
        <span class="font-mono text-xs uppercase tracking-wider text-on-surface-variant/70 self-start md:self-auto rounded-full bg-surface-container-highest px-3 py-1">
          Graduated 2023
        </span>
      </div>
    </div>

    <!-- Certifications Grid with GCP ACE prominent -->
    <div>
      <div class="mb-6 flex items-center gap-3">
        <Award class="h-5 w-5 text-primary" stroke-width={1.6} aria-hidden="true" />
        <h3 class="font-headline text-lg font-bold text-on-background">Verified Certifications</h3>
      </div>

      <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
        <!-- Prominent GCP ACE Card -->
        <div class="relative overflow-hidden rounded-2xl border border-primary-container/30 bg-primary-container/10 p-6 shadow-[0_0_20px_rgba(0,240,255,0.08)]">
          <div class="mb-4 flex items-center justify-between">
            <div class="flex h-10 w-10 items-center justify-center rounded-lg bg-surface-container-lowest text-primary">
              <Cloud class="h-5 w-5" stroke-width={1.75} aria-hidden="true" />
            </div>
            <span class="rounded-full bg-primary/20 px-2.5 py-0.5 font-mono text-[0.65rem] font-semibold uppercase tracking-wider text-primary">
              Primary Cloud
            </span>
          </div>
          <h4 class="font-headline text-base font-bold text-on-background">
            Google Cloud Certified – Associate Cloud Engineer (GCP ACE)
          </h4>
          <p class="mt-2 text-xs font-mono text-on-surface-variant">Earned February 2024</p>
        </div>

        <!-- Microsoft Azure Card -->
        <div class="rounded-2xl border border-outline-variant/15 bg-surface-container-low p-6 transition-all hover:bg-surface-container/90">
          <div class="mb-4 flex items-center justify-between">
            <div class="flex h-10 w-10 items-center justify-center rounded-lg bg-surface-container-lowest text-primary">
              <Cloud class="h-5 w-5" stroke-width={1.75} aria-hidden="true" />
            </div>
          </div>
          <h4 class="font-headline text-base font-bold text-on-background">
            Microsoft Azure Fundamentals (AZ-900)
          </h4>
          <p class="mt-2 text-xs font-mono text-on-surface-variant">Earned February 2021</p>
        </div>

        <!-- Cisco Networking Card -->
        <div class="rounded-2xl border border-outline-variant/15 bg-surface-container-low p-6 transition-all hover:bg-surface-container/90">
          <div class="mb-4 flex items-center justify-between">
            <div class="flex h-10 w-10 items-center justify-center rounded-lg bg-surface-container-lowest text-primary">
              <ShieldCheck class="h-5 w-5" stroke-width={1.75} aria-hidden="true" />
            </div>
          </div>
          <h4 class="font-headline text-base font-bold text-on-background">
            Cisco Enterprise Networking, Security &amp; Automation
          </h4>
          <p class="mt-2 text-xs font-mono text-on-surface-variant">Earned March 2021</p>
        </div>
      </div>
    </div>
  </div>
</section>
