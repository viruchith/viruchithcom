---
import Container from './ui/Container.astro';
import ThemeSwitch from './ThemeSwitch.astro';
import { siteConfig } from '../config/site';
import { formatIsoDay } from '../lib/format';
import { version } from '../../package.json';

const built = formatIsoDay(new Date());

const groups = [
  {
    title: 'Site',
    links: [
      { href: '/', label: 'Home' },
      { href: '/projects/', label: 'Projects' },
      { href: '/articles/', label: 'Articles' },
      { href: '/rss.xml', label: 'RSS feed' },
    ],
  },
  {
    title: 'Elsewhere',
    links: [
      { href: siteConfig.socials.github, label: 'GitHub', external: true },
      { href: siteConfig.socials.linkedin, label: 'LinkedIn', external: true },
      { href: siteConfig.socials.x, label: 'X', external: true },
    ],
  },
  {
    title: 'Contact',
    links: [
      { href: `mailto:${siteConfig.email}`, label: siteConfig.email },
      ...(siteConfig.resumeUrl ? [{ href: siteConfig.resumeUrl, label: 'Resume (PDF)', external: true }] : []),
    ],
  },
];
---

<footer class="mt-8 border-t border-rule">
  <Container>
    <div class="grid gap-y-8 py-10 md:grid-cols-12 md:gap-x-8">
      <div class="md:col-span-3">
        <p class="text-small font-semibold text-ink">{siteConfig.name}</p>
        <p class="mt-1 text-small text-muted">{siteConfig.headlineRole}, {siteConfig.location}</p>
        <div class="mt-4">
          <ThemeSwitch name="theme-footer" />
        </div>
      </div>
      <nav aria-label="Footer" class="grid grid-cols-2 gap-x-8 gap-y-8 sm:grid-cols-3 md:col-span-9">
        {
          groups.map((group) => (
            <div class="min-w-0">
              <h2 class="text-meta text-faint">{group.title}</h2>
              <ul class="mt-3 flex flex-col gap-2 text-small">
                {group.links.map((link) => (
                  <li class="min-w-0 break-words">
                    <a
                      href={link.href}
                      class="link-quiet"
                      target={link.external ? '_blank' : undefined}
                      rel={link.external ? 'noopener noreferrer' : undefined}
                    >
                      {link.label}
                      {link.external && <span class="sr-only"> (opens in a new tab)</span>}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </nav>
    </div>
    <div class="flex flex-wrap items-center justify-between gap-x-6 gap-y-1 border-t border-rule py-4 font-mono text-meta text-faint">
      <span>viruchith.com</span>
      <span>v{version} · built <time datetime={built}>{built}</time></span>
      <span aria-hidden="true">VIRUCHITH</span>
    </div>
  </Container>
</footer>
