---
import { Mail, Rss } from '@lucide/astro';
import BrandGithub from './icons/BrandGithub.astro';
import BrandLinkedin from './icons/BrandLinkedin.astro';
import BrandX from './icons/BrandX.astro';
import { siteConfig } from '../config/site';
import { version } from '../../package.json';

const year = new Date().getFullYear();

const navLinks = [
  { href: '/#experience', label: 'Experience' },
  { href: '/#projects', label: 'Projects' },
  { href: '/#skills', label: 'Skills' },
  { href: '/articles/', label: 'Articles' },
  { href: '/#contact', label: 'Contact' },
];
---

<footer
  class="w-full border-t border-outline-variant/10 bg-background transition-colors duration-500 ease-out"
>
  <div class="mx-auto max-w-7xl px-6 py-12 md:px-8 lg:px-12">
    <!-- Top tier: Brand & Site Navigation -->
    <div class="flex flex-col gap-6 md:flex-row md:items-center md:justify-between pb-8 border-b border-outline-variant/10">
      <div class="space-y-1">
        <a
          href="/"
          class="font-headline text-lg font-extrabold tracking-[-0.08em] text-on-background transition-colors hover:text-primary"
        >
          VIRUCHITH.COM
        </a>
        <p class="font-body text-xs text-on-surface-variant/80">
          Backend Engineer · Java, Spring Boot &amp; Distributed Systems
        </p>
      </div>

      <nav class="flex flex-wrap items-center gap-x-6 gap-y-2.5 font-body text-sm font-medium tracking-wide text-on-surface-variant" aria-label="Footer navigation">
        {
          navLinks.map((link) => (
            <a
              href={link.href}
              class="transition-colors hover:text-primary"
            >
              {link.label}
            </a>
          ))
        }
      </nav>
    </div>

    <!-- Bottom tier: Copyright, Socials & Meta -->
    <div class="flex flex-col-reverse items-center justify-between gap-6 pt-6 sm:flex-row">
      <p class="font-body text-xs tracking-wide text-on-surface-variant/75 text-center sm:text-left">
        © {year} {siteConfig.name}. Built with precision.
        <span class="ml-2 font-mono text-[11px] opacity-60">v{version}</span>
      </p>

      <div class="flex items-center gap-1 sm:gap-2" aria-label="Social and syndication links">
        <a
          class="inline-flex h-9 w-9 items-center justify-center rounded-lg text-on-surface-variant transition-colors hover:bg-white/5 hover:text-primary"
          href={siteConfig.socials.github}
          target="_blank"
          rel="noopener noreferrer"
          aria-label="GitHub profile"
          title="GitHub"
        >
          <BrandGithub class="h-4 w-4" />
        </a>
        <a
          class="inline-flex h-9 w-9 items-center justify-center rounded-lg text-on-surface-variant transition-colors hover:bg-white/5 hover:text-primary"
          href={siteConfig.socials.linkedin}
          target="_blank"
          rel="noopener noreferrer"
          aria-label="LinkedIn profile"
          title="LinkedIn"
        >
          <BrandLinkedin class="h-4 w-4" />
        </a>
        <a
          class="inline-flex h-9 w-9 items-center justify-center rounded-lg text-on-surface-variant transition-colors hover:bg-white/5 hover:text-primary"
          href={siteConfig.socials.x}
          target="_blank"
          rel="noopener noreferrer"
          aria-label="X (Twitter) profile"
          title="X"
        >
          <BrandX class="h-4 w-4" />
        </a>
        <a
          class="inline-flex h-9 w-9 items-center justify-center rounded-lg text-on-surface-variant transition-colors hover:bg-white/5 hover:text-primary"
          href={`mailto:${siteConfig.email}`}
          aria-label="Email Viruchith"
          title={`Email (${siteConfig.email})`}
        >
          <Mail class="h-4 w-4" stroke-width={1.75} aria-hidden="true" />
        </a>
        <a
          class="inline-flex h-9 w-9 items-center justify-center rounded-lg text-on-surface-variant transition-colors hover:bg-white/5 hover:text-primary"
          href="/rss.xml"
          aria-label="RSS Feed"
          title="RSS Feed"
        >
          <Rss class="h-4 w-4" stroke-width={1.75} aria-hidden="true" />
        </a>
      </div>
    </div>
  </div>
</footer>
