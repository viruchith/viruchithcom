---
import type { HTMLTag } from 'astro/types';

interface Props {
  as?: HTMLTag;
  cols?: 1 | 2 | 3;
  ruled?: boolean;
  class?: string;
  [key: string]: unknown;
}

const { as: Tag = 'div', cols = 2, ruled = false, class: className, ...rest } = Astro.props;

const colClasses = {
  1: 'grid-cols-1',
  2: 'grid-cols-1 xl:grid-cols-2',
  3: 'grid-cols-1 md:grid-cols-2 xl:grid-cols-3',
} as const;
---

<Tag
  class:list={[
    'grid gap-x-8',
    colClasses[cols as 1 | 2 | 3],
    ruled ? 'gap-y-0 border-t border-rule [&>*]:border-b [&>*]:border-rule' : 'gap-y-8',
    className,
  ]}
  {...rest}
>
  <slot />
</Tag>
