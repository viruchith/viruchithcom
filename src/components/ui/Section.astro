---
interface Props {
  id: string;
  title: string;
  level?: 1 | 2;
  rule?: boolean;
  showAnchor?: boolean;
  class?: string;
}

const { id, title, level = 2, rule = true, showAnchor = true, class: className } = Astro.props;
const Tag = level === 1 ? 'h1' : 'h2';
const headingId = `${id}-heading`;
---

<section
  id={id}
  aria-labelledby={headingId}
  data-section={title}
  class:list={[rule && 'border-t border-rule', 'py-12 md:py-16', className]}
>
  <div class="grid gap-y-6 md:grid-cols-12 md:gap-x-8">
    <div class="md:col-span-3">
      <div class="flex items-baseline justify-between gap-4 md:sticky md:top-[calc(var(--header-h)+2rem)] md:block">
        <Tag id={headingId} class="text-section font-semibold">{title}</Tag>
        {showAnchor && (
          <a href={`#${id}`} class="anchor-id md:mt-1.5 md:inline-block" aria-label={`Link to ${title}`}>#{id}</a>
        )}
        <slot name="aside" />
      </div>
    </div>
    <div class="min-w-0 md:col-span-9">
      <slot />
    </div>
  </div>
</section>
