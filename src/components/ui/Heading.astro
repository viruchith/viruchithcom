---
interface Props {
  level?: 1 | 2 | 3 | 4;
  size?: 'display' | 'page' | 'section' | 'title';
  id?: string;
  class?: string;
}

const { level = 2, size, id, class: className } = Astro.props;
const Tag = `h${level}` as 'h1' | 'h2' | 'h3' | 'h4';

const defaultSize = { 1: 'page', 2: 'section', 3: 'title', 4: 'title' } as const;

const sizeClasses = {
  display: 'text-display font-semibold',
  page: 'text-page font-semibold',
  section: 'text-section font-semibold',
  title: 'text-title font-semibold',
} as const;
---

<Tag {id} class:list={[sizeClasses[size ?? defaultSize[level]], className]}>
  <slot />
</Tag>
