---
import type { HTMLTag } from 'astro/types';

type Gap = 1 | 2 | 3 | 4 | 6 | 8 | 10 | 12;

interface Props {
  as?: HTMLTag;
  gap?: Gap;
  class?: string;
  [key: string]: unknown;
}

const { as: Tag = 'div', gap = 4, class: className, ...rest } = Astro.props;

const gapClasses: Record<Gap, string> = {
  1: 'gap-1',
  2: 'gap-2',
  3: 'gap-3',
  4: 'gap-4',
  6: 'gap-6',
  8: 'gap-8',
  10: 'gap-10',
  12: 'gap-12',
};
---

<Tag class:list={['flex flex-col', gapClasses[gap], className]} {...rest}>
  <slot />
</Tag>
