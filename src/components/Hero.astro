---
import Link from './ui/Link.astro';
import CopyEmail from './CopyEmail.astro';
import { siteConfig } from '../config/site';
---

<section id="top" aria-labelledby="name-heading" data-section={`${siteConfig.headlineRole} · ${siteConfig.location}`} class="pb-12 pt-5 md:pb-16 md:pt-14">
  <div class="grid gap-y-4 md:grid-cols-12 md:gap-x-8">
    <p class="row-label hidden md:col-span-3 md:block" aria-hidden="true">Name</p>
    <h1 id="name-heading" class="max-w-[24ch] text-display font-semibold md:col-span-9">
      {siteConfig.name}
      <span class="text-muted">— backend engineer building high-throughput Java and Spring&nbsp;Boot systems.</span>
    </h1>
  </div>

  <div class="mt-6 grid gap-y-4 md:mt-10 md:grid-cols-12 md:gap-x-8 md:border-t md:border-rule md:pt-6">
    <p class="row-label hidden md:col-span-3 md:block" aria-hidden="true">Synopsis</p>
    <div class="md:col-span-9">
      <p class="max-w-[52ch] text-lead text-ink">
        Open to full-time backend engineering roles and select Spring Boot modernization consulting, in Bengaluru or remote.
      </p>
      <div class="mt-5 flex flex-wrap gap-3">
        <a href={`mailto:${siteConfig.email}`} class="btn btn-primary">Email me</a>
        {siteConfig.resumeUrl && (
          <a href={siteConfig.resumeUrl} class="btn btn-secondary" target="_blank" rel="noopener noreferrer">
            Resume (PDF)<span class="sr-only"> (opens in a new tab)</span>
          </a>
        )}
      </div>
      <CopyEmail class="mt-4" />
    </div>
  </div>

  <div class="mt-10 grid gap-y-4 border-t border-rule pt-6 md:grid-cols-12 md:gap-x-8">
    <p class="row-label hidden md:col-span-3 md:block" aria-hidden="true">Description</p>
    <div class="grid gap-y-8 md:col-span-9 xl:grid-cols-9 xl:gap-x-8">
      <div class="flex max-w-[62ch] flex-col gap-4 text-body xl:col-span-5">
        <p>
          I design, scale, and modernize backend systems for enterprise teams. At Lumen Technologies I led the
          containerization of legacy Tomcat, WildFly, and Restlet applications into Spring Boot microservices on
          Kubernetes and GCP, and built telecom qualification APIs that sustain
          <Link href="#exp-software-development-engineer" variant="xref" trail="Experience: Software Development Engineer, Lumen Technologies" class="figure">100,000+ requests a day</Link>.
        </p>
        <p>
          My work centres on Java, Spring Boot, RabbitMQ messaging, PostgreSQL, Linux administration, and production
          observability with Splunk, Datadog, and AppDynamics. I also write about the systems behind everyday software in
          <Link href="/articles/" variant="xref" trail="Articles: the full index">the articles</Link>.
        </p>
      </div>
      <dl class="grid grid-cols-[6.5rem_minmax(0,1fr)] gap-x-4 gap-y-3 self-start border-t border-rule pt-4 text-small [&_.figure]:font-mono max-w-[62ch] xl:col-span-4 xl:max-w-none xl:border-l xl:border-t-0 xl:pl-6 xl:pt-0">
        <dt class="text-faint">Experience</dt>
        <dd class="text-ink">
          <Link href="#experience" variant="xref" trail="Experience: roles at Lumen Technologies"><span class="figure">3+</span> years</Link>, Lumen Technologies
        </dd>
        <dt class="text-faint">Throughput</dt>
        <dd class="text-ink">
          <Link href="#exp-software-development-engineer" variant="xref" trail="Experience: Software Development Engineer, Lumen Technologies"><span class="figure">100,000+</span> requests/day</Link>
        </dd>
        <dt class="text-faint">Certified</dt>
        <dd class="text-ink">
          <Link href="#certifications" variant="xref" trail="Education: certifications">Google Cloud ACE, Generative AI Leader</Link>
        </dd>
        <dt class="text-faint">Based in</dt>
        <dd class="text-ink">{siteConfig.location}</dd>
        <dt class="text-faint">Open to</dt>
        <dd class="text-ink">Full-time roles and consulting, Bengaluru or remote</dd>
      </dl>
    </div>
  </div>
</section>
