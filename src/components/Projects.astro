---
import Section from './ui/Section.astro';
import Grid from './ui/Grid.astro';
import Link from './ui/Link.astro';
import ProjectItem from './ui/ProjectItem.astro';
import { featuredProjects, moreProjects } from '../data/projects';
---

<Section id="projects" title="Projects">
  <p class="max-w-[62ch] text-body text-muted">
    Phish Slayer, Android Shredder, and Prompt Butler lead, followed by backend and platform work. Each links to its source.
  </p>
  <Grid cols={2} ruled class="mt-6">
    {featuredProjects.map((project) => <ProjectItem project={project} />)}
  </Grid>
  <p class="mt-6 text-small">
    <Link href="/projects/" variant="xref" trail="Projects: the full archive">All {featuredProjects.length + moreProjects.length} projects, including web, desktop, and mobile work</Link>
  </p>
</Section>
