---
import { ZoomIn, ZoomOut, RotateCcw, X } from '@lucide/astro';
---

<dialog
  id="article-zoom-dialog"
  class="media-zoom-dialog"
  aria-modal="true"
  aria-label="Media zoom viewer"
>
  <div class="media-zoom-shell" data-zoom-shell>
    <!-- Top Bar -->
    <header class="media-zoom-header" data-zoom-header>
      <div class="flex items-center gap-2.5 min-w-0 pr-2">
        <span class="badge font-mono text-meta tracking-wider uppercase border-rule text-muted" data-zoom-type>IMAGE</span>
        <span class="truncate font-mono text-meta text-muted" data-zoom-title>Zoom View</span>
      </div>
      <div class="flex items-center gap-1 sm:gap-2 shrink-0">
        <span class="badge font-mono text-meta text-muted figure px-2 border-rule" data-zoom-pct>100%</span>
        <button
          type="button"
          class="btn btn-ghost btn-sm h-8 w-8 p-0 text-muted hover:bg-ink hover:text-paper"
          data-zoom-out
          aria-label="Zoom out"
          title="Zoom out (-)"
        >
          <ZoomOut class="h-4 w-4" stroke-width={1.75} aria-hidden="true" />
        </button>
        <button
          type="button"
          class="btn btn-ghost btn-sm h-8 w-8 p-0 text-muted hover:bg-ink hover:text-paper"
          data-zoom-in
          aria-label="Zoom in"
          title="Zoom in (+)"
        >
          <ZoomIn class="h-4 w-4" stroke-width={1.75} aria-hidden="true" />
        </button>
        <button
          type="button"
          class="btn btn-ghost btn-sm h-8 w-8 p-0 text-muted hover:bg-ink hover:text-paper"
          data-zoom-reset
          aria-label="Reset zoom"
          title="Reset zoom (0)"
        >
          <RotateCcw class="h-4 w-4" stroke-width={1.75} aria-hidden="true" />
        </button>
        <div class="h-4 w-px bg-rule mx-0.5"></div>
        <button
          type="button"
          class="btn btn-ghost btn-sm h-8 px-2 flex items-center gap-1.5 text-muted hover:bg-ink hover:text-paper"
          data-zoom-close
          aria-label="Close zoom preview"
          title="Close (Esc)"
        >
          <X class="h-4 w-4" stroke-width={1.75} aria-hidden="true" />
          <span class="hidden sm:inline font-mono text-meta">Esc</span>
        </button>
      </div>
    </header>

    <!-- Canvas Stage -->
    <div class="media-zoom-stage" data-zoom-stage>
      <div class="media-zoom-canvas" data-zoom-canvas>
        <div class="media-zoom-content" data-zoom-content></div>
      </div>
    </div>

    <!-- Bottom Instruction Bar -->
    <footer class="media-zoom-footer">
      <span class="hidden sm:inline font-mono text-meta text-faint">
        Scroll or pinch to zoom · Drag to pan · Double-click to toggle · Esc to exit
      </span>
      <span class="sm:hidden font-mono text-meta text-faint">
        Pinch to zoom · Drag to pan · Double-tap to toggle
      </span>
    </footer>
  </div>
</dialog>

<style is:global>
  dialog.media-zoom-dialog {
    position: fixed;
    inset: 0;
    margin: 0;
    width: 100vw;
    height: 100vh;
    max-width: none;
    max-height: none;
    border: none;
    padding: 0;
    background: transparent;
    color: var(--ink);
    z-index: 9999;
    overflow: hidden;
  }

  dialog.media-zoom-dialog::backdrop {
    background-color: var(--paper);
    opacity: 0.94;
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
  }

  dialog.media-zoom-dialog[open] {
    animation: zoomModalFadeIn 150ms cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  @keyframes zoomModalFadeIn {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  .media-zoom-shell {
    display: flex;
    flex-direction: column;
    width: 100vw;
    height: 100vh;
    overflow: hidden;
    user-select: none;
  }

  .media-zoom-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 3rem;
    padding: 0 1rem;
    background-color: var(--paper);
    border-bottom: 1px solid var(--rule);
    z-index: 10;
    flex-shrink: 0;
  }

  .media-zoom-stage {
    flex: 1;
    position: relative;
    width: 100%;
    height: calc(100vh - 5rem);
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    touch-action: none;
    cursor: zoom-out;
  }

  .media-zoom-canvas {
    display: flex;
    align-items: center;
    justify-content: center;
    transform-origin: center center;
    will-change: transform;
    cursor: grab;
  }

  .media-zoom-canvas.is-dragging {
    cursor: grabbing !important;
  }

  .media-zoom-content {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    max-width: none;
    max-height: none;
    pointer-events: auto;
  }

  .media-zoom-content img {
    max-width: 90vw;
    max-height: 78vh;
    width: auto;
    height: auto;
    object-fit: contain;
    border: 1px solid var(--rule-strong);
    border-radius: 2px;
    pointer-events: auto;
  }

  .media-zoom-diagram-card {
    background-color: var(--raised);
    border: 1px solid var(--rule-strong);
    border-radius: 2px;
    padding: 1.5rem;
    box-sizing: border-box;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    max-width: none;
    max-height: none;
    pointer-events: auto;
  }

  @media (max-width: 640px) {
    .media-zoom-diagram-card {
      padding: 0.75rem;
    }
  }

  .media-zoom-diagram-card svg {
    display: block;
    overflow: visible;
  }

  /* Ensure Mermaid edge labels and backgrounds maintain high contrast inside zoom modal */
  .media-zoom-diagram-card .labelBkg,
  .media-zoom-diagram-card .edgeLabel,
  .media-zoom-diagram-card .edgeLabel p,
  .media-zoom-diagram-card .edgeLabel span {
    background-color: var(--raised) !important;
    color: var(--ink) !important;
  }

  .media-zoom-diagram-card .labelBkg {
    padding: 0.15rem 0.4rem !important;
  }

  .media-zoom-diagram-card .edgeLabel rect {
    fill: var(--raised) !important;
  }

  .media-zoom-footer {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 2rem;
    border-top: 1px solid var(--rule);
    background-color: var(--paper);
    padding: 0 1rem;
    flex-shrink: 0;
    z-index: 10;
  }
</style>

<script>
  function initArticleZoom() {
    const dialog = document.getElementById('article-zoom-dialog') as HTMLDialogElement | null;
    if (!dialog) return;

    const stage = dialog.querySelector<HTMLElement>('[data-zoom-stage]');
    const canvas = dialog.querySelector<HTMLElement>('[data-zoom-canvas]');
    const content = dialog.querySelector<HTMLElement>('[data-zoom-content]');
    const titleEl = dialog.querySelector<HTMLElement>('[data-zoom-title]');
    const typeEl = dialog.querySelector<HTMLElement>('[data-zoom-type]');
    const pctEl = dialog.querySelector<HTMLElement>('[data-zoom-pct]');
    const btnIn = dialog.querySelector<HTMLButtonElement>('[data-zoom-in]');
    const btnOut = dialog.querySelector<HTMLButtonElement>('[data-zoom-out]');
    const btnReset = dialog.querySelector<HTMLButtonElement>('[data-zoom-reset]');
    const btnClose = dialog.querySelector<HTMLButtonElement>('[data-zoom-close]');

    if (!stage || !canvas || !content || !pctEl) return;

    let scale = 1.0;
    let translateX = 0;
    let translateY = 0;
    let isDragging = false;
    let startPointerX = 0;
    let startPointerY = 0;
    let startTranslateX = 0;
    let startTranslateY = 0;
    let hasMoved = false;
    let lastActiveElement: HTMLElement | null = null;

    // Touch pinch state
    let initialPinchDistance = 0;
    let initialPinchScale = 1.0;
    let lastTapTime = 0;

    function applyTransform(smooth = false) {
      if (!canvas || !pctEl) return;
      canvas.style.transition = smooth ? 'transform 160ms cubic-bezier(0.16, 1, 0.3, 1)' : 'none';
      canvas.style.transform = `translate3d(${translateX}px, ${translateY}px, 0) scale(${scale})`;
      pctEl.textContent = `${Math.round(scale * 100)}%`;
      if (scale > 1.05) {
        canvas.style.cursor = isDragging ? 'grabbing' : 'grab';
      } else {
        canvas.style.cursor = 'zoom-in';
      }
    }

    function setZoom(newScale: number, originX = 0, originY = 0, smooth = false) {
      const clampedScale = Math.min(Math.max(newScale, 0.4), 5.0);
      if (originX !== 0 || originY !== 0) {
        const factor = clampedScale / scale;
        translateX = originX - (originX - translateX) * factor;
        translateY = originY - (originY - translateY) * factor;
      } else if (clampedScale <= 1.0) {
        translateX = 0;
        translateY = 0;
      }
      scale = clampedScale;
      applyTransform(smooth);
    }

    function resetZoom(smooth = true) {
      scale = 1.0;
      translateX = 0;
      translateY = 0;
      applyTransform(smooth);
    }

    function getSvgDimensions(svg: SVGElement): { width: number; height: number } {
      const viewBoxAttr = svg.getAttribute('viewBox');
      if (viewBoxAttr) {
        const parts = viewBoxAttr.trim().split(/[\s,]+/).map(Number);
        if (parts.length === 4 && !isNaN(parts[2]) && !isNaN(parts[3]) && parts[2] > 0 && parts[3] > 0) {
          return { width: parts[2], height: parts[3] };
        }
      }

      if ('viewBox' in svg && (svg as SVGSVGElement).viewBox?.baseVal) {
        const vb = (svg as SVGSVGElement).viewBox.baseVal;
        if (vb.width > 0 && vb.height > 0) {
          return { width: vb.width, height: vb.height };
        }
      }

      const rawW = svg.getAttribute('width');
      const rawH = svg.getAttribute('height');
      if (rawW && rawH && !rawW.includes('%') && !rawH.includes('%')) {
        const w = parseFloat(rawW);
        const h = parseFloat(rawH);
        if (w > 0 && h > 0) return { width: w, height: h };
      }

      const styleMaxWidth = parseFloat(svg.style.maxWidth || '');
      const bcr = svg.getBoundingClientRect();
      if (bcr.width > 0 && bcr.height > 0) {
        if (styleMaxWidth > 0 && Math.abs(styleMaxWidth - bcr.width) > 1) {
          const ratio = bcr.height / bcr.width;
          return { width: styleMaxWidth, height: styleMaxWidth * ratio };
        }
        return { width: bcr.width, height: bcr.height };
      }

      return { width: 800, height: 480 };
    }

    function openModal(options: { type: 'IMAGE' | 'DIAGRAM'; title: string; element: HTMLElement }) {
      if (!dialog || !content) return;
      lastActiveElement = document.activeElement as HTMLElement | null;
      content.innerHTML = '';

      if (typeEl) typeEl.textContent = options.type;
      if (titleEl) titleEl.textContent = options.title || (options.type === 'DIAGRAM' ? 'Architecture Diagram' : 'Image');

      if (options.type === 'IMAGE') {
        const origImg = options.element as HTMLImageElement;
        const zoomImg = document.createElement('img');
        zoomImg.src = origImg.currentSrc || origImg.src;
        zoomImg.alt = origImg.alt || '';
        zoomImg.draggable = false;
        content.appendChild(zoomImg);
      } else {
        const svg = options.element.tagName.toLowerCase() === 'svg'
          ? (options.element as unknown as SVGElement)
          : options.element.querySelector('svg');

        if (svg) {
          const card = document.createElement('div');
          card.className = 'media-zoom-diagram-card mermaid';
          card.style.width = 'fit-content';
          card.style.height = 'fit-content';

          const clonedSvg = svg.cloneNode(true) as SVGElement;

          // Preserve original ID so internal scoped <style> (#id ...) and defs/markers (#id-arrowhead ...) apply!
          // DO NOT removeAttribute('id')!

          const { width: vbWidth, height: vbHeight } = getSvgDimensions(svg);
          const isMobile = window.innerWidth < 640;
          const pad = isMobile ? 32 : 64;
          const availWidth = Math.max(window.innerWidth - pad, 260);
          const availHeight = Math.max(window.innerHeight - 80 - pad, 200);

          const maxScaleCap = vbWidth < 500 ? 1.4 : (vbWidth < 800 ? 1.2 : 1.0);
          const fitScale = Math.min(availWidth / vbWidth, availHeight / vbHeight, maxScaleCap);
          const renderWidth = Math.max(Math.round(vbWidth * fitScale), Math.min(Math.round(vbWidth), 240));
          const renderHeight = Math.round(renderWidth * (vbHeight / vbWidth));

          clonedSvg.setAttribute('width', String(renderWidth));
          clonedSvg.setAttribute('height', String(renderHeight));
          clonedSvg.style.width = `${renderWidth}px`;
          clonedSvg.style.height = `${renderHeight}px`;
          clonedSvg.style.maxWidth = 'none';
          clonedSvg.style.maxHeight = 'none';
          clonedSvg.style.display = 'block';

          card.appendChild(clonedSvg);
          content.appendChild(card);
        }
      }

      resetZoom(false);
      document.documentElement.style.overflow = 'hidden';
      dialog.showModal();
      btnClose?.focus();
    }

    function closeModal() {
      if (!dialog || !content) return;
      dialog.close();
      content.innerHTML = '';
      document.documentElement.style.overflow = '';
      if (lastActiveElement && typeof lastActiveElement.focus === 'function') {
        lastActiveElement.focus();
      }
    }

    // Controls
    btnIn?.addEventListener('click', () => setZoom(scale * 1.25, 0, 0, true));
    btnOut?.addEventListener('click', () => setZoom(scale * 0.8, 0, 0, true));
    btnReset?.addEventListener('click', () => resetZoom(true));
    btnClose?.addEventListener('click', closeModal);

    dialog.addEventListener('close', () => {
      document.documentElement.style.overflow = '';
    });

    dialog.addEventListener('cancel', (e) => {
      e.preventDefault();
      closeModal();
    });

    // Wheel zoom centered around cursor
    stage.addEventListener('wheel', (e) => {
      e.preventDefault();
      const rect = stage.getBoundingClientRect();
      const originX = e.clientX - rect.left - rect.width / 2;
      const originY = e.clientY - rect.top - rect.height / 2;
      const factor = e.deltaY < 0 ? 1.15 : 0.87;
      setZoom(scale * factor, originX, originY, false);
    }, { passive: false });

    // Pointer drag to pan
    stage.addEventListener('pointerdown', (e) => {
      if ((e.target as HTMLElement).closest('button')) return;

      isDragging = true;
      hasMoved = false;
      startPointerX = e.clientX;
      startPointerY = e.clientY;
      startTranslateX = translateX;
      startTranslateY = translateY;
      canvas.classList.add('is-dragging');
      stage.setPointerCapture(e.pointerId);
    });

    stage.addEventListener('pointermove', (e) => {
      if (!isDragging) return;
      const dx = e.clientX - startPointerX;
      const dy = e.clientY - startPointerY;
      if (Math.hypot(dx, dy) > 4) {
        hasMoved = true;
      }
      translateX = startTranslateX + dx;
      translateY = startTranslateY + dy;
      applyTransform(false);
    });

    const onPointerUp = (e: PointerEvent) => {
      if (!isDragging) return;
      isDragging = false;
      canvas.classList.remove('is-dragging');
      try {
        stage.releasePointerCapture(e.pointerId);
      } catch {}

      if (!hasMoved) {
        const targetEl = (e.target instanceof Element) ? e.target : (e.target as Node | null)?.parentElement;
        const clickedContent = targetEl?.closest('[data-zoom-content]');
        if (!clickedContent) {
          closeModal();
        } else {
          const now = Date.now();
          if (now - lastTapTime < 300) {
            if (scale > 1.1) {
              resetZoom(true);
            } else {
              const rect = stage.getBoundingClientRect();
              const originX = e.clientX - rect.left - rect.width / 2;
              const originY = e.clientY - rect.top - rect.height / 2;
              setZoom(2.0, originX, originY, true);
            }
          }
          lastTapTime = now;
        }
      }
    };

    stage.addEventListener('pointerup', onPointerUp);
    stage.addEventListener('pointercancel', onPointerUp);

    // Multi-touch pinch-to-zoom for mobile
    stage.addEventListener('touchstart', (e) => {
      if (e.touches.length === 2) {
        isDragging = false;
        const touch1 = e.touches[0];
        const touch2 = e.touches[1];
        initialPinchDistance = Math.hypot(touch1.clientX - touch2.clientX, touch1.clientY - touch2.clientY);
        initialPinchScale = scale;
      }
    }, { passive: true });

    stage.addEventListener('touchmove', (e) => {
      if (e.touches.length === 2 && initialPinchDistance > 0) {
        const touch1 = e.touches[0];
        const touch2 = e.touches[1];
        const currentDist = Math.hypot(touch1.clientX - touch2.clientX, touch1.clientY - touch2.clientY);
        const newScale = (currentDist / initialPinchDistance) * initialPinchScale;
        const rect = stage.getBoundingClientRect();
        const midX = (touch1.clientX + touch2.clientX) / 2 - rect.left - rect.width / 2;
        const midY = (touch1.clientY + touch2.clientY) / 2 - rect.top - rect.height / 2;
        setZoom(newScale, midX, midY, false);
      }
    }, { passive: true });

    // Keyboard controls
    window.addEventListener('keydown', (e) => {
      if (!dialog.open) return;
      if (e.key === 'Escape') {
        e.preventDefault();
        closeModal();
      } else if (e.key === '+' || e.key === '=') {
        e.preventDefault();
        setZoom(scale * 1.25, 0, 0, true);
      } else if (e.key === '-' || e.key === '_') {
        e.preventDefault();
        setZoom(scale * 0.8, 0, 0, true);
      } else if (e.key === '0') {
        e.preventDefault();
        resetZoom(true);
      } else if (e.key === 'ArrowLeft') {
        e.preventDefault();
        translateX += 40;
        applyTransform(true);
      } else if (e.key === 'ArrowRight') {
        e.preventDefault();
        translateX -= 40;
        applyTransform(true);
      } else if (e.key === 'ArrowUp') {
        e.preventDefault();
        translateY += 40;
        applyTransform(true);
      } else if (e.key === 'ArrowDown') {
        e.preventDefault();
        translateY -= 40;
        applyTransform(true);
      }
    });

    // Attach triggers to article images
    function setupImages() {
      const images = Array.from(document.querySelectorAll<HTMLImageElement>(
        '[data-article-body] img, article figure img[data-zoomable], [data-article-body] figure img'
      ));

      images.forEach((img) => {
        if (img.dataset.zoomBound) return;
        img.dataset.zoomBound = 'true';
        img.setAttribute('role', 'button');
        img.setAttribute('tabindex', '0');
        const caption = img.alt?.trim() || img.closest('figure')?.querySelector('figcaption')?.textContent?.trim() || 'Article image';
        img.setAttribute('aria-label', `Zoom image: ${caption}`);

        const triggerOpen = () => {
          openModal({
            type: 'IMAGE',
            title: caption,
            element: img,
          });
        };

        img.addEventListener('click', triggerOpen);
        img.addEventListener('keydown', (e) => {
          if (e.key === 'Enter' || e.key === ' ') {
            e.preventDefault();
            triggerOpen();
          }
        });
      });
    }

    // Attach triggers to mermaid diagrams
    function setupMermaid() {
      const diagrams = Array.from(document.querySelectorAll<HTMLElement>('[data-article-body] pre.mermaid'));

      diagrams.forEach((pre) => {
        let frame = pre.parentElement?.classList.contains('diagram-frame') ? pre.parentElement : null;
        if (!frame) {
          frame = document.createElement('div');
          frame.className = 'diagram-frame';
          pre.replaceWith(frame);
          frame.appendChild(pre);
        }

        let zoomBtn = frame.querySelector<HTMLButtonElement>('.diagram-frame__zoom');
        if (!zoomBtn) {
          zoomBtn = document.createElement('button');
          zoomBtn.type = 'button';
          zoomBtn.className = 'diagram-frame__zoom btn btn-ghost btn-sm';
          zoomBtn.setAttribute('aria-label', 'Zoom diagram');
          zoomBtn.innerHTML = `
            <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-maximize-2" aria-hidden="true">
              <polyline points="15 3 21 3 21 9"></polyline>
              <polyline points="9 21 3 21 3 15"></polyline>
              <line x1="21" y1="3" x2="14" y2="10"></line>
              <line x1="3" y1="21" x2="10" y2="14"></line>
            </svg>
            <span class="font-mono text-meta tracking-wide">Zoom</span>
          `;
          frame.appendChild(zoomBtn);
        }

        function getDiagramTitle() {
          const svgTitle = pre.querySelector('.titleText, title')?.textContent?.trim();
          if (svgTitle) return svgTitle;

          let prev = frame?.previousElementSibling;
          while (prev) {
            if (/^H[1-6]$/.test(prev.tagName)) return prev.textContent?.trim() || 'Architecture Diagram';
            if (prev.tagName === 'P' && prev.textContent?.trim()) {
              return prev.textContent.trim().slice(0, 60);
            }
            prev = prev.previousElementSibling;
          }
          return 'Architecture Diagram';
        }

        const triggerOpen = () => {
          const svg = pre.querySelector('svg');
          if (svg) {
            openModal({
              type: 'DIAGRAM',
              title: getDiagramTitle(),
              element: pre,
            });
          } else {
            const obs = new MutationObserver(() => {
              if (pre.querySelector('svg')) {
                obs.disconnect();
                openModal({
                  type: 'DIAGRAM',
                  title: getDiagramTitle(),
                  element: pre,
                });
              }
            });
            obs.observe(pre, { childList: true });
          }
        };

        if (!pre.dataset.zoomBound) {
          pre.dataset.zoomBound = 'true';
          pre.setAttribute('tabindex', '0');
          pre.setAttribute('role', 'button');
          pre.setAttribute('aria-label', 'Zoom architecture diagram');
          pre.addEventListener('click', triggerOpen);
          pre.addEventListener('keydown', (e) => {
            if (e.key === 'Enter' || e.key === ' ') {
              e.preventDefault();
              triggerOpen();
            }
          });
        }

        if (zoomBtn && !zoomBtn.dataset.bound) {
          zoomBtn.dataset.bound = 'true';
          zoomBtn.addEventListener('click', (e) => {
            e.stopPropagation();
            triggerOpen();
          });
        }
      });
    }

    setupImages();
    setupMermaid();

    const articleBody = document.querySelector('[data-article-body]');
    if (articleBody) {
      const observer = new MutationObserver(() => {
        setupImages();
        setupMermaid();
      });
      observer.observe(articleBody, { childList: true, subtree: true });
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initArticleZoom);
  } else {
    initArticleZoom();
  }
</script>
