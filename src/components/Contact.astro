---
import Section from './ui/Section.astro';
import Link from './ui/Link.astro';
import CopyEmail from './CopyEmail.astro';
import { siteConfig } from '../config/site';
---

<Section id="contact" title="Contact">
  <p class="max-w-[30ch] text-section font-semibold text-ink">Email is the fastest way to reach me.</p>
  <p class="mt-3 max-w-[60ch] text-body text-muted">
    For full-time backend roles, cloud-native modernization work, or a Spring Boot consulting engagement. Based in
    {siteConfig.location}, open to on-site work in Bengaluru and to remote teams.
  </p>
  <div class="mt-6 flex flex-wrap gap-3">
    <a href={`mailto:${siteConfig.email}`} class="btn btn-primary">Email me</a>
    {siteConfig.resumeUrl && (
      <a href={siteConfig.resumeUrl} class="btn btn-secondary" target="_blank" rel="noopener noreferrer">
        Resume (PDF)<span class="sr-only"> (opens in a new tab)</span>
      </a>
    )}
    {siteConfig.bookingUrl && (
      <a href={siteConfig.bookingUrl} class="btn btn-secondary" target="_blank" rel="noopener noreferrer">
        Book a call<span class="sr-only"> (opens in a new tab)</span>
      </a>
    )}
  </div>
  <CopyEmail class="mt-4" />
  <dl class="mt-8 grid grid-cols-[6.5rem_minmax(0,1fr)] gap-x-4 gap-y-2 border-t border-rule pt-4 text-small sm:max-w-md">
    <dt class="text-faint">LinkedIn</dt>
    <dd><Link href={siteConfig.socials.linkedin} external>in/viruchith</Link></dd>
    <dt class="text-faint">GitHub</dt>
    <dd><Link href={siteConfig.socials.github} external>github.com/viruchith</Link></dd>
    <dt class="text-faint">X</dt>
    <dd><Link href={siteConfig.socials.x} external>@viruchith</Link></dd>
  </dl>
</Section>
