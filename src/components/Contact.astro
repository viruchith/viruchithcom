---
import { Mail, Calendar, MapPin, ArrowRight, FileText } from '@lucide/astro';
import BrandGithub from './icons/BrandGithub.astro';
import BrandLinkedin from './icons/BrandLinkedin.astro';
import BrandX from './icons/BrandX.astro';
import { siteConfig } from '../config/site';
---

<section id="contact" class="mb-32 px-6 md:px-12 lg:px-24" aria-labelledby="contact-heading">
  <div class="mb-12 flex items-end justify-between border-b border-surface-container-low pb-8 transition-colors">
    <div>
      <h2 id="contact-heading" class="font-headline mb-2 text-3xl font-bold text-on-background md:text-4xl">
        Contact
      </h2>
      <p class="font-body text-on-surface-variant">
        Let's discuss backend architecture, microservices scaling, or consulting engagements.
      </p>
    </div>
    <Mail class="h-10 w-10 shrink-0 text-primary opacity-50 md:h-11 md:w-11" stroke-width={1.25} aria-hidden="true" />
  </div>

  <div class="relative overflow-hidden rounded-[2rem] border border-outline-variant/15 bg-surface-container-low p-6 sm:p-8 md:p-14">
    <div
      class="pointer-events-none absolute -right-24 -top-24 h-96 w-96 rounded-full bg-[radial-gradient(circle,rgba(0,240,255,0.12),transparent_70%)] blur-2xl"
      aria-hidden="true"
    />

    <div class="relative z-10 max-w-3xl">
      <span class="inline-flex items-center gap-2 rounded-full border border-primary-container/30 bg-primary-container/10 px-3.5 py-1 text-xs font-mono font-medium text-primary uppercase tracking-wider">
        <span class="h-2 w-2 rounded-full bg-emerald-400"></span>
        Available for opportunities
      </span>

      <h3 class="font-headline mt-6 text-2xl font-bold text-on-background md:text-3xl">
        Ready to build or modernize high-throughput systems?
      </h3>

      <p class="mt-4 font-body text-base leading-relaxed text-on-surface-variant md:text-lg">
        I am actively exploring full-time backend engineering roles, cloud-native modernization initiatives, and select technical consulting engagements. Let's discuss how my experience with Java, Spring Boot, and Kubernetes can support your team's goals.
      </p>

      <div class="mt-8 flex items-center gap-2 text-sm text-on-surface font-body">
        <MapPin class="h-4 w-4 text-primary shrink-0" aria-hidden="true" />
        <span>Location: <strong>{siteConfig.location}</strong> · Open to Bengaluru &amp; Remote arrangements</span>
      </div>

      <!-- Action buttons -->
      <div class="mt-10 flex flex-wrap items-center gap-3.5 sm:gap-4">
        <a
          class="stitch-gradient-hero group inline-flex max-w-full items-center justify-center gap-2.5 rounded-full px-5 py-3.5 sm:px-8 sm:py-4 text-xs sm:text-sm font-semibold uppercase tracking-wider transition hover:shadow-[0_0_24px_rgba(0,240,255,0.28)]"
          href={`mailto:${siteConfig.email}`}
        >
          <Mail class="h-4 w-4 shrink-0" stroke-width={1.8} aria-hidden="true" />
          <span class="hidden sm:inline">Email {siteConfig.email}</span>
          <span class="sm:hidden">Email Viruchith</span>
          <ArrowRight class="h-4 w-4 shrink-0 transition-transform group-hover:translate-x-1" stroke-width={1.8} aria-hidden="true" />
        </a>

        {siteConfig.hasResume && siteConfig.resumeUrl && (
          <a
            class="inline-flex max-w-full items-center justify-center gap-2 rounded-full border border-outline-variant/25 bg-surface-variant/30 px-5 py-3.5 sm:px-6 sm:py-4 text-xs sm:text-sm font-semibold uppercase tracking-wider text-on-surface transition hover:border-primary-container/40 hover:text-primary-container"
            href={siteConfig.resumeUrl}
            target="_blank"
            rel="noopener noreferrer"
          >
            <FileText class="h-4 w-4 text-primary shrink-0" stroke-width={1.8} aria-hidden="true" />
            <span>Resume (PDF)</span>
          </a>
        )}

        {siteConfig.bookingUrl && (
          <a
            class="inline-flex max-w-full items-center justify-center gap-2 rounded-full border border-outline-variant/25 bg-surface-variant/30 px-5 py-3.5 sm:px-6 sm:py-4 text-xs sm:text-sm font-semibold uppercase tracking-wider text-on-surface transition hover:border-primary-container/40 hover:text-primary-container"
            href={siteConfig.bookingUrl}
            target="_blank"
            rel="noopener noreferrer"
          >
            <Calendar class="h-4 w-4 text-primary shrink-0" stroke-width={1.8} aria-hidden="true" />
            <span>Book a call</span>
          </a>
        )}
      </div>

      <p class="mt-4 text-xs text-on-surface-variant/75 font-mono">
        Direct inbox: <a href={`mailto:${siteConfig.email}`} class="text-primary hover:underline">{siteConfig.email}</a>
      </p>

      <!-- Social and alternate channels -->
      <div class="mt-12 pt-8 border-t border-outline-variant/15 flex flex-wrap items-center gap-6 text-sm">
        <span class="font-mono text-xs uppercase tracking-wider text-on-surface-variant/70">Connect:</span>
        <a
          class="inline-flex items-center gap-2 text-on-surface-variant transition-colors hover:text-primary"
          href={siteConfig.socials.linkedin}
          target="_blank"
          rel="noopener noreferrer"
        >
          <BrandLinkedin class="h-4 w-4" />
          <span>LinkedIn</span>
        </a>
        <a
          class="inline-flex items-center gap-2 text-on-surface-variant transition-colors hover:text-primary"
          href={siteConfig.socials.github}
          target="_blank"
          rel="noopener noreferrer"
        >
          <BrandGithub class="h-4 w-4" />
          <span>GitHub</span>
        </a>
        <a
          class="inline-flex items-center gap-2 text-on-surface-variant transition-colors hover:text-primary"
          href={siteConfig.socials.x}
          target="_blank"
          rel="noopener noreferrer"
        >
          <BrandX class="h-4 w-4" />
          <span>X (Twitter)</span>
        </a>
      </div>
    </div>
  </div>
</section>
