---
import { Menu, X } from '@lucide/astro';
import Container from './ui/Container.astro';
import ThemeSwitch from './ThemeSwitch.astro';
import { siteConfig } from '../config/site';

export type NavKey = 'home' | 'articles' | 'projects' | 'other';

interface Props {
  current?: NavKey;
  /** Running-header title shown beside the wordmark on wide screens. */
  trail?: string;
}

const { current = 'other', trail = siteConfig.headlineRole } = Astro.props;

const links = [
  { href: '/#experience', label: 'Experience', section: 'experience' },
  { href: '/#projects', label: 'Projects', section: 'projects', page: 'projects' },
  { href: '/articles/', label: 'Articles', page: 'articles', section: 'articles' },
  { href: '/#contact', label: 'Contact', section: 'contact' },
];
---

<header class="sticky top-0 z-40 border-b border-rule bg-paper" data-site-header data-track-sections={current === 'home' ? '' : undefined}>
  <div data-header-bar>
  <Container class="flex h-[var(--bar-h)] items-center gap-3 md:gap-4">
    <a
      href="/"
      class="title-link -mx-1 shrink-0 px-1 font-mono text-small font-semibold tracking-tight"
      aria-label={`${siteConfig.name}, home`}
    >VIRUCHITH</a>

    <p
      class="hidden min-w-0 flex-1 truncate text-small text-faint md:block"
      aria-hidden="true"
      data-trail-slot
      data-trail-default={trail}
    >{trail}</p>

    <nav aria-label="Primary" class="ml-auto hidden lg:block">
      <ul class="flex items-center gap-0.5">
        {
          links.map((link) => (
            <li>
              <a
                href={link.href}
                class="nav-link"
                data-nav-section={link.section}
                aria-current={link.page && link.page === current ? 'page' : undefined}
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <ThemeSwitch name="theme-header" class="!hidden md:!inline-flex md:ml-auto lg:ml-0" />

    <a href={`mailto:${siteConfig.email}`} class="btn btn-primary btn-sm ml-auto md:ml-0">Email</a>

    {siteConfig.resumeUrl && (
      <a href={siteConfig.resumeUrl} class="btn btn-secondary btn-sm no-js-only md:hidden" target="_blank" rel="noopener noreferrer">
        Resume<span class="sr-only"> (opens in a new tab)</span>
      </a>
    )}

    <button
      type="button"
      class="btn btn-ghost btn-sm -mr-2 js-only md:hidden"
      aria-expanded="false"
      aria-controls="mobile-nav"
      data-menu-button
    >
      <Menu class="h-5 w-5" stroke-width={1.75} aria-hidden="true" data-menu-open-icon />
      <X class="hidden h-5 w-5" stroke-width={1.75} aria-hidden="true" data-menu-close-icon />
      <span class="sr-only" data-menu-label>Open menu</span>
    </button>
  </Container>
  </div>

  <nav aria-label="Sections" class="border-t border-rule lg:hidden">
    <Container class="flex h-[var(--subnav-h)] items-center">
      <ul class="-mx-2 flex items-center overflow-x-auto">
        {
          links.map((link) => (
            <li class="shrink-0">
              <a
                href={link.href}
                class="nav-link !px-2"
                data-nav-section={link.section}
                aria-current={link.page && link.page === current ? 'page' : undefined}
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </Container>
  </nav>

  <div id="mobile-nav" class="border-t border-rule bg-paper md:hidden" hidden data-menu-panel>
    <Container class="py-4">
      <div class="flex flex-col gap-3">
        <ThemeSwitch name="theme-mobile" showLabels class="!flex w-full" />
        {siteConfig.resumeUrl && (
          <a href={siteConfig.resumeUrl} class="btn btn-secondary w-full" target="_blank" rel="noopener noreferrer">
            Resume (PDF)<span class="sr-only"> (opens in a new tab)</span>
          </a>
        )}
      </div>
    </Container>
  </div>
</header>

<style is:global>
  .nav-link {
    @apply inline-flex h-8 items-center rounded px-2.5 text-small text-muted;
    transition:
      background-color 120ms ease-out,
      color 120ms ease-out;
  }

  .nav-link:hover,
  .nav-link[aria-current] {
    background: var(--ink);
    color: var(--paper);
  }
</style>

<script>
  function initMenu() {
    const button = document.querySelector<HTMLButtonElement>('[data-menu-button]');
    const panel = document.querySelector<HTMLElement>('[data-menu-panel]');
    if (!button || !panel || button.dataset.bound) return;
    button.dataset.bound = '1';

    const label = button.querySelector('[data-menu-label]');
    const openIcon = button.querySelector('[data-menu-open-icon]');
    const closeIcon = button.querySelector('[data-menu-close-icon]');

    const setOpen = (open: boolean) => {
      panel.hidden = !open;
      button.setAttribute('aria-expanded', String(open));
      if (label) label.textContent = open ? 'Close menu' : 'Open menu';
      openIcon?.classList.toggle('hidden', open);
      closeIcon?.classList.toggle('hidden', !open);
    };

    button.addEventListener('click', () => setOpen(panel.hidden));
    panel.querySelectorAll('[data-menu-link]').forEach((link) => link.addEventListener('click', () => setOpen(false)));
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && !panel.hidden) {
        setOpen(false);
        button.focus();
      }
    });
  }

  function initRunningHeader() {
    const slot = document.querySelector<HTMLElement>('[data-trail-slot]');
    const navLinks = document.querySelectorAll<HTMLAnchorElement>('[data-nav-section]');
    let sectionTitle = slot?.dataset.trailDefault ?? '';
    let trailActive = false;

    const showDefault = () => {
      if (slot && !trailActive) slot.textContent = sectionTitle;
    };

    const tracksSections = document.querySelector('[data-site-header]')?.hasAttribute('data-track-sections');
    const sections = tracksSections
      ? Array.from(document.querySelectorAll<HTMLElement>('main section[data-section]'))
      : [];
    if (sections.length && 'IntersectionObserver' in window) {
      const observer = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (!entry.isIntersecting) continue;
            const target = entry.target as HTMLElement;
            sectionTitle = target.dataset.section ?? sectionTitle;
            showDefault();
            navLinks.forEach((link) => {
              if (link.dataset.navSection === target.id) link.setAttribute('aria-current', 'location');
              else if (link.getAttribute('aria-current') === 'location') link.removeAttribute('aria-current');
            });
          }
        },
        { rootMargin: '-40% 0px -55% 0px' },
      );
      sections.forEach((section) => observer.observe(section));
    }

    if (!slot) return;

    const showTrail = (event: Event) => {
      const origin = (event.target as Element | null)?.closest?.<HTMLElement>('[data-trail]');
      if (!origin?.dataset.trail) return;
      trailActive = true;
      slot.textContent = `→ ${origin.dataset.trail}`;
    };
    const hideTrail = (event: Event) => {
      const origin = (event.target as Element | null)?.closest?.('[data-trail]');
      if (!origin) return;
      trailActive = false;
      showDefault();
    };

    document.addEventListener('pointerover', showTrail);
    document.addEventListener('pointerout', hideTrail);
    document.addEventListener('focusin', showTrail);
    document.addEventListener('focusout', hideTrail);
  }

  function fitHeader() {
    const header = document.querySelector<HTMLElement>('[data-site-header]');
    const bar = header?.querySelector<HTMLElement>('[data-header-bar]');
    if (!header || !bar) return;
    const tooTall = header.offsetHeight > window.innerHeight * 0.22;
    header.dataset.headerFit = tooTall ? 'bar' : 'all';
    if (tooTall) {
      document.documentElement.style.setProperty('--header-h', `${bar.offsetHeight + 1}px`);
    } else {
      document.documentElement.style.removeProperty('--header-h');
    }
  }

  let fitQueued = false;
  function queueFitHeader() {
    if (fitQueued) return;
    fitQueued = true;
    requestAnimationFrame(() => {
      fitQueued = false;
      fitHeader();
    });
  }

  initMenu();
  initRunningHeader();
  queueFitHeader();
  window.addEventListener('resize', queueFitHeader);
</script>
