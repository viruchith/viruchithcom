---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Container from '../../components/ui/Container.astro';
import Section from '../../components/ui/Section.astro';
import Grid from '../../components/ui/Grid.astro';
import ProjectItem from '../../components/ui/ProjectItem.astro';
import { featuredProjects, moreProjects } from '../../data/projects';
import { siteConfig } from '../../config/site';

const title = 'Projects | Viruchith Ganesan';
const description =
  'Open-source projects by Viruchith Ganesan: backend and platform engineering with Spring Boot, Kubernetes, and LLM tooling, plus web, desktop, and mobile work.';
const total = featuredProjects.length + moreProjects.length;

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: title,
  description,
  url: 'https://viruchith.com/projects/',
  isPartOf: {
    '@type': 'WebSite',
    name: 'viruchith.com',
    url: 'https://viruchith.com',
  },
  hasPart: [...featuredProjects, ...moreProjects]
    .filter((project) => project.link)
    .map((project) => ({
      '@type': 'SoftwareSourceCode',
      name: project.title,
      description: project.approach,
      codeRepository: project.link,
      author: { '@type': 'Person', name: siteConfig.name },
    })),
};
---

<BaseLayout title={title} description={description} structuredData={structuredData} current="projects" trail="Projects">
  <Container>
    <header class="grid gap-y-4 pb-10 pt-8 md:grid-cols-12 md:gap-x-8 md:pb-12 md:pt-14">
      <p class="row-label hidden md:col-span-3 md:block" aria-hidden="true">Archive</p>
      <div class="md:col-span-9">
        <h1 class="text-page font-semibold">Projects</h1>
        <p class="mt-4 max-w-[56ch] text-lead text-muted">
          Phish Slayer, Android Shredder, and Prompt Butler come first, then backend and platform work, then the rest of
          the archive. Every project links to its source.
        </p>
        <p class="mt-3 text-small text-faint"><span class="figure">{total}</span> projects</p>
      </div>
    </header>

    <Section id="featured" title="Featured">
      <Grid cols={2} ruled>
        {featuredProjects.map((project) => <ProjectItem project={project} />)}
      </Grid>
    </Section>

    <Section id="other" title="Other work">
      <Grid cols={2} ruled>
        {moreProjects.map((project) => <ProjectItem project={project} />)}
      </Grid>
    </Section>
  </Container>
</BaseLayout>
