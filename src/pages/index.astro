---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import Hero from '../components/Hero.astro';
import About from '../components/About.astro';
import Experience from '../components/Experience.astro';
import Projects from '../components/Projects.astro';
import Expertise from '../components/Expertise.astro';
import ArticlesCarousel from '../components/ArticlesCarousel.astro';
import EducationCerts from '../components/EducationCerts.astro';
import Testimonials from '../components/Testimonials.astro';
import Contact from '../components/Contact.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { getLatestBlogPosts, mapBlogPost } from '../lib/blog';
import { siteConfig } from '../config/site';

const title = siteConfig.title;
const description = siteConfig.description;
const latestPosts = (await getLatestBlogPosts(6)).map(mapBlogPost);
---

<BaseLayout {title} {description}>
  <a href="#main" class="skip-to-content">Skip to content</a>
  <SiteHeader />
  <main id="main" class="mx-auto max-w-screen-2xl pb-24 pt-28 md:pt-32">
    <Hero />
    <div class="deferred-render">
      <About />
    </div>
    <div class="deferred-render">
      <Experience />
    </div>
    <div class="deferred-render">
      <Projects />
    </div>
    <div class="deferred-render">
      <Expertise />
    </div>
    <div class="deferred-render">
      <ArticlesCarousel posts={latestPosts} />
    </div>
    <div class="deferred-render">
      <EducationCerts />
    </div>
    <Testimonials />
    <div class="deferred-render">
      <Contact />
    </div>
  </main>
  <SiteFooter />
</BaseLayout>
