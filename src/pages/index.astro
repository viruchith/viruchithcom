---
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/ui/Container.astro';
import Hero from '../components/Hero.astro';
import Experience from '../components/Experience.astro';
import Projects from '../components/Projects.astro';
import Expertise from '../components/Expertise.astro';
import EducationCerts from '../components/EducationCerts.astro';
import SeeAlso from '../components/SeeAlso.astro';
import Testimonials from '../components/Testimonials.astro';
import Contact from '../components/Contact.astro';
import KnownIssues from '../components/KnownIssues.astro';
import { getAllBlogPosts, mapBlogPost } from '../lib/blog';
import { siteConfig } from '../config/site';

const allPosts = await getAllBlogPosts();
const latestPosts = allPosts.slice(0, 6).map(mapBlogPost);
---

<BaseLayout title={siteConfig.title} description={siteConfig.description} current="home" trail={`${siteConfig.headlineRole} · ${siteConfig.location}`}>
  <Container>
    <Hero />
    <SeeAlso posts={latestPosts} total={allPosts.length} />
    <Experience />
    <Projects />
    <Expertise />
    <EducationCerts />
    <Testimonials />
    <Contact />
    <KnownIssues />
  </Container>
</BaseLayout>
