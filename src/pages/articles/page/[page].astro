---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Container from '../../../components/ui/Container.astro';
import ArticleIndex from '../../../components/ArticleIndex.astro';
import { ARTICLES_DESCRIPTION, ARTICLES_PER_PAGE, getAllBlogPosts, mapBlogPost } from '../../../lib/blog';

export async function getStaticPaths() {
  const posts = await getAllBlogPosts();
  const totalPages = Math.ceil(posts.length / ARTICLES_PER_PAGE);

  return Array.from({ length: Math.max(0, totalPages - 1) }, (_, i) => ({
    params: { page: String(i + 2) },
  }));
}

const allPosts = (await getAllBlogPosts()).map(mapBlogPost);
const totalPages = Math.ceil(allPosts.length / ARTICLES_PER_PAGE);
const pageNum = parseInt(Astro.params.page || '1', 10);

if (isNaN(pageNum) || pageNum < 2 || pageNum > totalPages) {
  return Astro.redirect('/articles/');
}

const start = (pageNum - 1) * ARTICLES_PER_PAGE;
const posts = allPosts.slice(start, start + ARTICLES_PER_PAGE);

const title = `Articles - Page ${pageNum} | Viruchith Ganesan`;
const baseUrl = 'https://viruchith.com/articles/';
const canonicalUrl = `${baseUrl}page/${pageNum}/`;
const prevUrl = pageNum === 2 ? baseUrl : `${baseUrl}page/${pageNum - 1}/`;
const nextUrl = pageNum < totalPages ? `${baseUrl}page/${pageNum + 1}/` : undefined;

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: title,
  description: ARTICLES_DESCRIPTION,
  url: canonicalUrl,
  isPartOf: {
    '@type': 'WebSite',
    name: 'viruchith.com',
    url: 'https://viruchith.com',
  },
};
---

<BaseLayout title={title} description={ARTICLES_DESCRIPTION} structuredData={structuredData} current="articles" trail={`Articles, page ${pageNum}`}>
  <Fragment slot="head">
    <link rel="prev" href={prevUrl} />
    {nextUrl && <link rel="next" href={nextUrl} />}
  </Fragment>
  <Container>
    <ArticleIndex posts={posts} page={pageNum} totalPages={totalPages} total={allPosts.length} />
  </Container>
</BaseLayout>
