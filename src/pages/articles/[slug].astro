---
import { ArrowLeft } from '@lucide/astro';
import { Image, getImage } from 'astro:assets';
import { render } from 'astro:content';
import type { BlogEntry } from '../../lib/blog';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Container from '../../components/ui/Container.astro';
import Section from '../../components/ui/Section.astro';
import Badge from '../../components/ui/Badge.astro';
import ArticleItem from '../../components/ui/ArticleItem.astro';
import ShareButtons from '../../components/ShareButtons.astro';
import 'katex/dist/katex.min.css';
import '../../styles/article-prose.css';

import { getAllBlogPosts, mapBlogPost, formatArticleDate, getBlogSlug } from '../../lib/blog';
import { formatIsoDay } from '../../lib/format';

export async function getStaticPaths() {
  const posts = await getAllBlogPosts();

  return posts.map((post: BlogEntry) => ({
    params: { slug: getBlogSlug(post) },
    props: { post },
    cacheKey: post.digest,
  }));
}

const { post } = Astro.props as { post: BlogEntry };
const article = mapBlogPost(post);
const { Content, headings } = await render(post);
const toc = headings.filter((heading) => heading.depth === 2);

const others = (await getAllBlogPosts()).map(mapBlogPost).filter((entry) => entry.slug !== article.slug);
const relatedPosts = others
  .map((entry, index) => ({
    entry,
    score:
      (entry.category === article.category ? 2 : 0) +
      entry.tags.filter((tag) => article.tags.includes(tag)).length -
      index * 0.01,
  }))
  .sort((a, b) => b.score - a.score)
  .slice(0, 4)
  .map(({ entry }) => entry);

const title = `${article.title} | Viruchith Ganesan`;
const description = article.description;
const articleUrl = `https://viruchith.com/articles/${article.slug}/`;

const heroImageSizes = '(max-width: 767px) 100vw, (max-width: 1200px) 75vw, 880px';
const heroImageWidths = [360, 480, 720, 960, 1200, 1600];

const optimizedHero = await getImage({
  src: article.heroImage,
  widths: heroImageWidths,
  sizes: heroImageSizes,
  format: 'webp',
  quality: 80,
});

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: article.title,
  description,
  datePublished: article.publishDate.toISOString(),
  dateModified: (article.updatedDate ?? article.publishDate).toISOString(),
  image: [`https://viruchith.com${article.heroImage.src}`],
  mainEntityOfPage: articleUrl,
  articleSection: article.category,
  keywords: article.tags.join(', '),
  author: {
    '@type': 'Person',
    name: 'Viruchith Ganesan',
    url: 'https://viruchith.com',
  },
  publisher: {
    '@type': 'Person',
    name: 'Viruchith Ganesan',
    url: 'https://viruchith.com',
  },
};
---

<BaseLayout
  title={title}
  description={description}
  ogType="article"
  ogImage={article.heroImage.src}
  structuredData={structuredData}
  current="articles"
  trail={article.title}
  preloadImage={{
    src: optimizedHero.src,
    srcset: optimizedHero.srcSet.attribute,
    sizes: heroImageSizes,
  }}
>
  <Container>
    <article>
      <header class="grid gap-y-6 pb-10 pt-8 md:grid-cols-12 md:gap-x-8 md:pt-14">
        <div class="md:col-span-3">
          <a href="/articles/" class="link-quiet inline-flex items-center gap-1.5 text-small">
            <ArrowLeft class="h-4 w-4" stroke-width={1.75} aria-hidden="true" />
            All articles
          </a>
        </div>
        <div class="min-w-0 md:col-span-9">
          <h1 class="max-w-[26ch] text-page font-semibold">{article.title}</h1>
          <p class="mt-5 max-w-[60ch] text-lead text-muted">{article.description}</p>
          <dl class="mt-8 grid grid-cols-2 gap-x-6 gap-y-4 border-t border-rule pt-4 text-small sm:grid-cols-4">
            <div>
              <dt class="text-faint">Published</dt>
              <dd class="mt-0.5 text-ink"><time datetime={formatIsoDay(article.publishDate)}>{formatArticleDate(article.publishDate)}</time></dd>
            </div>
            {article.updatedDate && (
              <div>
                <dt class="text-faint">Updated</dt>
                <dd class="mt-0.5 text-ink"><time datetime={formatIsoDay(article.updatedDate)}>{formatArticleDate(article.updatedDate)}</time></dd>
              </div>
            )}
            <div>
              <dt class="text-faint">Reading time</dt>
              <dd class="figure mt-0.5 text-ink">{article.readingTime}</dd>
            </div>
            <div>
              <dt class="text-faint">Category</dt>
              <dd class="mt-0.5 text-ink">{article.category}</dd>
            </div>
          </dl>
          <div class="mt-6 flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
            {article.tags.length > 0 && (
              <ul class="flex flex-wrap gap-1.5" aria-label="Tags">
                {article.tags.map((tag) => <li><Badge>{tag}</Badge></li>)}
              </ul>
            )}
            <ShareButtons id="top" url={articleUrl} title={article.title} description={article.description} />
          </div>
        </div>
      </header>

      <div class="md:grid md:grid-cols-12 md:gap-x-8">
        <figure class="md:col-span-9 md:col-start-4">
          <Image
            src={article.heroImage}
            alt={article.heroAlt}
            widths={heroImageWidths}
            sizes={heroImageSizes}
            quality={80}
            format="webp"
            loading="eager"
            decoding="async"
            fetchpriority="high"
            class="aspect-[16/9] w-full border border-rule object-cover"
          />
        </figure>
      </div>

      <div class="mt-12 pb-16 md:grid md:grid-cols-12 md:gap-x-8">
        {toc.length > 1 && (
          <nav aria-labelledby="toc-heading" class="hidden md:col-span-3 lg:block">
            <div class="sticky top-[calc(var(--header-h)+2rem)] max-h-[calc(100vh-var(--header-h)-4rem)] overflow-y-auto pr-2">
              <h2 id="toc-heading" class="text-small font-medium text-faint">On this page</h2>
              <ol class="mt-3 flex flex-col gap-0.5 border-l border-rule">
                {toc.map((heading) => (
                  <li>
                    <a href={`#${heading.slug}`} class="toc-link" data-toc-link={heading.slug}>{heading.text}</a>
                  </li>
                ))}
              </ol>
            </div>
          </nav>
        )}
        <div class="article-prose min-w-0 md:col-span-9 md:col-start-4" data-article-body>
          <Content />
        </div>
      </div>

      <footer class="border-t border-rule py-8 md:grid md:grid-cols-12 md:gap-x-8">
        <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between md:col-span-9 md:col-start-4">
          <p class="text-small text-muted">
            Written by <a href="/" class="link">Viruchith Ganesan</a>, backend engineer in Bengaluru.
          </p>
          <ShareButtons id="end" url={articleUrl} title={article.title} description={article.description} />
        </div>
      </footer>
    </article>

    {relatedPosts.length > 0 && (
      <Section id="see-also" title="See also">
        <ul class="border-t border-rule">
          {relatedPosts.map((entry) => <ArticleItem post={entry} />)}
        </ul>
      </Section>
    )}
  </Container>
</BaseLayout>

<style is:global>
  .toc-link {
    @apply -ml-px block border-l border-transparent py-1 pl-3 text-small text-muted;
    transition:
      color 120ms ease-out,
      border-color 120ms ease-out,
      background-color 120ms ease-out;
  }

  .toc-link:hover {
    @apply border-faint text-ink;
  }

  .toc-link[aria-current] {
    @apply border-ink text-ink;
  }
</style>

<script>
  function initCodeCopy() {
    document.querySelectorAll<HTMLPreElement>('[data-article-body] pre.astro-code').forEach((pre) => {
      if (pre.parentElement?.classList.contains('code-frame')) return;
      const frame = document.createElement('div');
      frame.className = 'code-frame';
      pre.replaceWith(frame);
      frame.appendChild(pre);

      const button = document.createElement('button');
      button.type = 'button';
      button.className = 'code-frame__copy btn btn-ghost btn-sm';
      button.textContent = 'Copy';
      button.setAttribute('aria-label', 'Copy code');
      button.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(pre.innerText);
          button.textContent = 'Copied';
        } catch {
          button.textContent = 'Select to copy';
        }
        window.setTimeout(() => (button.textContent = 'Copy'), 2000);
      });
      frame.appendChild(button);
    });
  }

  function initToc() {
    const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-toc-link]'));
    if (!links.length || !('IntersectionObserver' in window)) return;
    const targets = links
      .map((link) => document.getElementById(link.dataset.tocLink ?? ''))
      .filter((node): node is HTMLElement => Boolean(node));

    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          links.forEach((link) => {
            if (link.dataset.tocLink === entry.target.id) link.setAttribute('aria-current', 'location');
            else link.removeAttribute('aria-current');
          });
        }
      },
      { rootMargin: '0px 0px -70% 0px' },
    );
    targets.forEach((target) => observer.observe(target));
  }

  initCodeCopy();
  initToc();
</script>
