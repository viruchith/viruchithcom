---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Container from '../../components/ui/Container.astro';
import ArticleIndex from '../../components/ArticleIndex.astro';
import { ARTICLES_DESCRIPTION, ARTICLES_PER_PAGE, getAllBlogPosts, mapBlogPost } from '../../lib/blog';

const allPosts = (await getAllBlogPosts()).map(mapBlogPost);
const totalPages = Math.ceil(allPosts.length / ARTICLES_PER_PAGE);
const posts = allPosts.slice(0, ARTICLES_PER_PAGE);

const title = 'Articles | Viruchith Ganesan';
const canonicalUrl = 'https://viruchith.com/articles/';
const nextUrl = totalPages > 1 ? 'https://viruchith.com/articles/page/2/' : undefined;

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: title,
  description: ARTICLES_DESCRIPTION,
  url: canonicalUrl,
  isPartOf: {
    '@type': 'WebSite',
    name: 'viruchith.com',
    url: 'https://viruchith.com',
  },
};
---

<BaseLayout title={title} description={ARTICLES_DESCRIPTION} structuredData={structuredData} current="articles" trail="Articles">
  <Fragment slot="head">
    {nextUrl && <link rel="next" href={nextUrl} />}
  </Fragment>
  <Container>
    <ArticleIndex posts={posts} page={1} totalPages={totalPages} total={allPosts.length} />
  </Container>
</BaseLayout>
