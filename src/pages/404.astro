---
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/ui/Container.astro';
import CodeBlock from '../components/ui/CodeBlock.astro';
import Link from '../components/ui/Link.astro';
import { siteConfig } from '../config/site';
---

<BaseLayout title="Page not found | Viruchith Ganesan" description="This page does not exist on viruchith.com." trail="Page not found">
  <Fragment slot="head">
    <meta name="robots" content="noindex" />
  </Fragment>
  <Container>
    <div class="grid gap-y-6 pb-20 pt-8 md:grid-cols-12 md:gap-x-8 md:pb-28 md:pt-14">
      <p class="row-label hidden md:col-span-3 md:block" aria-hidden="true">Error 404</p>
      <div class="min-w-0 md:col-span-9">
        <h1 class="max-w-[22ch] text-page font-semibold">No manual entry for this page.</h1>
        <p class="mt-4 max-w-[56ch] text-lead text-muted">
          The address may be mistyped, or the page has moved. Older article page numbers changed when the index grew.
        </p>
        <CodeBlock class="mt-8 max-w-xl" title="Terminal">$ man <span data-missing-path>this-page</span>
No manual entry for <span data-missing-path>this-page</span></CodeBlock>
        <ul class="mt-8 flex flex-col gap-2 text-body">
          <li><Link href="/">Home</Link><span class="text-muted">: experience, projects, and contact</span></li>
          <li><Link href="/articles/">Articles</Link><span class="text-muted">: all technical writing, with search</span></li>
          <li><Link href="/projects/">Projects</Link><span class="text-muted">: the full project archive</span></li>
          <li><Link href={`mailto:${siteConfig.email}`}>Email {siteConfig.email}</Link><span class="text-muted">: if a link here sent you nowhere</span></li>
        </ul>
      </div>
    </div>
  </Container>
</BaseLayout>

<script>
  const path = decodeURIComponent(location.pathname);
  if (path && path !== '/404' && path !== '/404.html') {
    document.querySelectorAll('[data-missing-path]').forEach((node) => {
      node.textContent = path;
    });
  }
</script>
